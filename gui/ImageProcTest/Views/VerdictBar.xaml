<UserControl x:Class="ImageProcTest.Views.VerdictBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ImageProcTest.Models"
             xmlns:viewModels="clr-namespace:ImageProcTest.ViewModels"
             Height="64"
             Background="#14171e">
    <Grid Margin="12,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="200" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Label block -->
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock Text="VERDICT" Foreground="#5a5f6a" FontSize="9"
                       FontWeight="Medium" />
            <TextBlock Foreground="#8a909c" FontSize="10" Margin="0,2,0,0">
                <Run Text="Record result for " /><Run Text="{Binding ActiveStudyId, FallbackValue=—}" />
            </TextBlock>
        </StackPanel>

        <!-- Notes input -->
        <TextBox Grid.Column="1"
                 AutomationProperties.AutomationId="VerdictNotesInput"
                 Text="{Binding VerdictNotes, UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Center"
                 Background="#0DFFFFFF"
                 Foreground="#f0f2f5"
                 BorderBrush="#1AFFFFFF"
                 BorderThickness="1"
                 Padding="9,6"
                 FontSize="11"
                 ToolTip="Optional notes for this verdict" />

        <!-- Verdict pills -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
            <!-- Pass -->
            <Button Command="{Binding RecordVerdictCommand}"
                    CommandParameter="{x:Static models:Verdict.Pass}"
                    Padding="16,6" Margin="0,0,6,0"
                    FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="#86efac" />
                        <Setter Property="BorderBrush" Value="#3386efac" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveVerdict}" Value="{x:Static models:Verdict.Pass}">
                                <Setter Property="Background" Value="#1A86efac" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                ✓ Pass
            </Button>

            <!-- Defer -->
            <Button Command="{Binding RecordVerdictCommand}"
                    CommandParameter="{x:Static models:Verdict.Defer}"
                    Padding="16,6" Margin="0,0,6,0"
                    FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="#fcd34d" />
                        <Setter Property="BorderBrush" Value="#33fcd34d" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveVerdict}" Value="{x:Static models:Verdict.Defer}">
                                <Setter Property="Background" Value="#1Afcd34d" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                ⏸ Defer
            </Button>

            <!-- Fail -->
            <Button Command="{Binding RecordVerdictCommand}"
                    CommandParameter="{x:Static models:Verdict.Fail}"
                    Padding="16,6"
                    FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="#fca5a5" />
                        <Setter Property="BorderBrush" Value="#33fca5a5" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveVerdict}" Value="{x:Static models:Verdict.Fail}">
                                <Setter Property="Background" Value="#1Afca5a5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                ✗ Fail
            </Button>
        </StackPanel>

        <!-- Save & Next -->
        <Button Grid.Column="3" Content="Save &amp; Next →"
                Command="{Binding SaveAndNextCommand}"
                Background="#7dd3fc" Foreground="#0c1220"
                BorderThickness="0" Padding="16,8"
                FontSize="11" FontWeight="SemiBold"
                Cursor="Hand" VerticalAlignment="Center"
                Margin="12,0,0,0" />
    </Grid>
</UserControl>
