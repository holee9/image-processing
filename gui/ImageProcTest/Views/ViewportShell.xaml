<UserControl x:Class="ImageProcTest.Views.ViewportShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ImageProcTest.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#08090c">
    <UserControl.Resources>
        <local:ZoomPercentConverter x:Key="ZoomPercentConverter" xmlns:local="clr-namespace:ImageProcTest.Views" />
    </UserControl.Resources>
    <Grid>
        <!-- Viewport layer -->
        <controls:ImageComparisonViewport x:Name="Viewport"
                                          AutomationProperties.AutomationId="WorkbenchViewport"
                                          SourceImage="{Binding LaneAImage}"
                                          ProcessedImage="{Binding LaneBImage}"
                                          CompareMode="{Binding Settings.ComparisonMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          ZoomScale="{Binding Settings.ComparisonZoomScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          PanX="{Binding Settings.ComparisonPanX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          PanY="{Binding Settings.ComparisonPanY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SwipePosition="{Binding Settings.ComparisonSwipePosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          OverlayOpacity="{Binding Settings.ComparisonOverlayOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <!-- View Toolbar (floating, top-center) -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,10,0,0"
                CornerRadius="12"
                Padding="6"
                Background="#D914171E">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.4" Color="#000000" />
            </Border.Effect>

            <StackPanel Orientation="Horizontal">
                <!-- Segmented comparison mode buttons -->
                <Border CornerRadius="8" Margin="0,0,2,0" Background="#1AFFFFFF">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Swipe"
                                Tag="SwipeVertical"
                                Click="CompareModeButton_Click"
                                Padding="12,6"
                                FontSize="11" FontWeight="Medium"
                                Foreground="#f0f2f5" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" />
                        <Button Content="Split"
                                Tag="SplitLocked"
                                Click="CompareModeButton_Click"
                                Padding="12,6"
                                FontSize="11" FontWeight="Medium"
                                Foreground="#f0f2f5" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" />
                        <Button Content="Overlay"
                                Tag="OverlayOpacity"
                                Click="CompareModeButton_Click"
                                Padding="12,6"
                                FontSize="11" FontWeight="Medium"
                                Foreground="#f0f2f5" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" />
                        <Button Content="Difference"
                                Tag="DifferenceHeatmap"
                                Click="CompareModeButton_Click"
                                Padding="12,6"
                                FontSize="11" FontWeight="Medium"
                                Foreground="#f0f2f5" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" />
                    </StackPanel>
                </Border>

                <!-- Separator -->
                <Rectangle Width="1" Fill="#1AFFFFFF" Margin="6,4" />

                <!-- Histogram toggle -->
                <ToggleButton x:Name="HistogramToggleButton"
                              AutomationProperties.AutomationId="HistogramToggleButton"
                              Content="Histogram"
                              IsChecked="{Binding HistogramActive, Mode=TwoWay}"
                              Padding="12,6"
                              FontSize="11" FontWeight="Medium"
                              Foreground="#f0f2f5"
                              Background="Transparent"
                              BorderThickness="0"
                              Cursor="Hand" />

                <!-- ROI toggle -->
                <ToggleButton x:Name="RoiToggleButton"
                              Content="ROI"
                              IsChecked="{Binding RoiActive, Mode=TwoWay}"
                              Padding="12,6"
                              FontSize="11" FontWeight="Medium"
                              Foreground="#f0f2f5"
                              Background="Transparent"
                              BorderThickness="0"
                              Cursor="Hand" />
            </StackPanel>
        </Border>

        <!-- HUD: STUDY block (top-left) -->
        <Border HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="10,10,0,0"
                CornerRadius="6"
                Padding="10,8"
                Background="#CC14171E">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.3" Color="#000000" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="STUDY" FontSize="9" FontWeight="SemiBold" Foreground="#5a5f6a"
                           Margin="0,0,0,3" />
                <TextBlock Text="{Binding ActiveStudyId, FallbackValue=—}"
                           FontSize="10" FontWeight="SemiBold" FontFamily="Consolas"
                           Foreground="#f0f2f5" />
                <TextBlock Text="{Binding ActiveImageSummary}"
                           FontSize="10" FontFamily="Consolas" Foreground="#8a909c"
                           TextWrapping="Wrap" MaxWidth="220" />
            </StackPanel>
        </Border>

        <!-- HUD: WINDOW block (top-right) -->
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,10,10,0"
                CornerRadius="6"
                Padding="10,8"
                Background="#CC14171E">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.3" Color="#000000" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="WINDOW" FontSize="9" FontWeight="SemiBold" Foreground="#5a5f6a"
                           Margin="0,0,0,3" />
                <TextBlock FontSize="10" FontFamily="Consolas">
                    <Run Text="C " Foreground="#8a909c" />
                    <Run Text="{Binding Settings.VoiWindowCenter, StringFormat={}{0:0}}" Foreground="#f0f2f5" />
                    <Run Text=" · W " Foreground="#8a909c" />
                    <Run Text="{Binding Settings.VoiWindowWidth, StringFormat={}{0:0}}" Foreground="#f0f2f5" />
                </TextBlock>
                <TextBlock FontSize="10" FontFamily="Consolas">
                    <Run Text="VOI: " Foreground="#8a909c" />
                    <Run Text="{Binding Settings.VoiLutMode}" Foreground="#f0f2f5" />
                </TextBlock>
                <TextBlock FontSize="10" FontFamily="Consolas">
                    <Run Text="Calib: " Foreground="#8a909c" />
                    <Run Text="{Binding CalibStageCountDisplay, Mode=OneWay}" Foreground="#f0f2f5" />
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Zoom Dock (floating, bottom-right) -->
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,10,10"
                CornerRadius="12"
                Padding="6"
                Background="#D914171E">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.4" Color="#000000" />
            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="-"
                        Command="{Binding ZoomOutCommand}"
                        Width="28" Height="28"
                        FontSize="14" FontWeight="Bold"
                        Foreground="#f0f2f5" Background="Transparent"
                        BorderThickness="0" Cursor="Hand" />

                <TextBlock x:Name="ZoomPercentText"
                           AutomationProperties.AutomationId="ZoomPercentText"
                           Text="{Binding Settings.ComparisonZoomScale, Converter={StaticResource ZoomPercentConverter}, FallbackValue=fit}"
                           Foreground="#f0f2f5" FontSize="11" FontWeight="Medium"
                           VerticalAlignment="Center"
                           Margin="8,0"
                           MinWidth="42"
                           TextAlignment="Center" />

                <Button Content="+"
                        Command="{Binding ZoomInCommand}"
                        Width="28" Height="28"
                        FontSize="14" FontWeight="Bold"
                        Foreground="#f0f2f5" Background="Transparent"
                        BorderThickness="0" Cursor="Hand" />

                <Rectangle Width="1" Fill="#1AFFFFFF" Margin="6,4" />

                <Button Content="Fit"
                        Command="{Binding ZoomFitCommand}"
                        Padding="10,4"
                        FontSize="11" FontWeight="Medium"
                        Foreground="#f0f2f5" Background="Transparent"
                        BorderThickness="0" Cursor="Hand" />

                <Button Content="1:1"
                        Command="{Binding ZoomActualCommand}"
                        Padding="10,4"
                        FontSize="11" FontWeight="Medium"
                        Foreground="#f0f2f5" Background="Transparent"
                        BorderThickness="0" Cursor="Hand" />
            </StackPanel>
        </Border>

        <!-- Lane tags (bottom corners) — hidden in DifferenceHeatmap mode -->
        <Border HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="10,0,0,10"
                CornerRadius="8"
                Padding="10,6"
                Background="#D914171E">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Settings.ComparisonMode}" Value="DifferenceHeatmap">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.3" Color="#000000" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Rectangle Width="4" Height="14" RadiusX="2" RadiusY="2" Fill="#7dd3fc" Margin="0,0,6,0" />
                <TextBlock FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center">
                    <Run Text="A" Foreground="#7dd3fc" /><Run Text=" " />
                    <Run Text="{Binding LaneAAlgorithm, FallbackValue=—}" Foreground="#b0b6c0" />
                </TextBlock>
            </StackPanel>
        </Border>

        <Border HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,250,10"
                CornerRadius="8"
                Padding="10,6"
                Background="#D914171E">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Settings.ComparisonMode}" Value="DifferenceHeatmap">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.3" Color="#000000" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Rectangle Width="4" Height="14" RadiusX="2" RadiusY="2" Fill="#c4b5fd" Margin="0,0,6,0" />
                <TextBlock FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center">
                    <Run Text="B" Foreground="#c4b5fd" /><Run Text=" " />
                    <Run Text="{Binding LaneBAlgorithm, FallbackValue=—}" Foreground="#b0b6c0" />
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Opacity slider (bottom-center, visible in Overlay mode only) -->
        <Border x:Name="OpacitySliderPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,10"
                CornerRadius="12"
                Padding="12,6"
                Background="#D914171E"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.4" Color="#000000" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Opacity" Foreground="#8a909c" FontSize="10"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <Slider Width="180"
                        Minimum="0" Maximum="1"
                        Value="{Binding Settings.ComparisonOverlayOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
