<UserControl x:Class="ImageProcTest.Views.TopBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="56"
             Background="#14171e">
    <Grid Margin="12,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Brand block -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
            <Border Width="28" Height="28" CornerRadius="4" Margin="0,0,8,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#22d3ee" Offset="0" />
                        <GradientStop Color="#3b82f6" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="X" Foreground="#0c1220" FontWeight="Bold"
                           FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="XPE Evaluation Workbench" Foreground="#f0f2f5"
                           FontSize="13" FontWeight="SemiBold" />
                <TextBlock Foreground="#5a5f6a" FontSize="10">
                    <Run Text="ImageProcTest GUI" /><Run Text=" · " />
                    <Run Text="Run #" /><Run Text="{Binding RunSet.RunId, FallbackValue=—}" />
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <!-- Run-set badge -->
        <Border Grid.Column="1" Background="#0dffffff" CornerRadius="10" Padding="12,6"
                VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="RUN-SET" Foreground="#5a5f6a" FontSize="9"
                           FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Foreground="#f0f2f5" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,12,0">
                    <Run Text="{Binding RunSet.Evaluated, Mode=OneWay, FallbackValue=0}" />
                    <Run Text=" / " />
                    <Run Text="{Binding RunSet.Total, FallbackValue=0}" />
                </TextBlock>
                <TextBlock Foreground="#86efac" FontSize="11" Margin="0,0,6,0"
                           VerticalAlignment="Center">
                    <Run Text="{Binding RunSet.Passed, FallbackValue=0}" /><Run Text=" pass" />
                </TextBlock>
                <TextBlock Foreground="#fca5a5" FontSize="11" Margin="0,0,6,0"
                           VerticalAlignment="Center">
                    <Run Text="{Binding RunSet.Failed, FallbackValue=0}" /><Run Text=" fail" />
                </TextBlock>
                <TextBlock Foreground="#fcd34d" FontSize="11" VerticalAlignment="Center">
                    <Run Text="{Binding RunSet.Deferred, FallbackValue=0}" /><Run Text=" defer" />
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Action buttons -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="Run on all queued" Command="{Binding RunOnAllQueuedCommand}"
                    Background="Transparent" Foreground="#8a909c" BorderBrush="#1affffff"
                    BorderThickness="1" Padding="12,6" Margin="0,0,8,0"
                    FontSize="11" FontWeight="Medium" Cursor="Hand" />
            <Button Content="Export bundle" Command="{Binding ExportEvidenceBundleCommand}"
                    Background="#7dd3fc" Foreground="#0c1220" BorderThickness="0"
                    Padding="12,6" Margin="0,0,8,0"
                    FontSize="11" FontWeight="SemiBold" Cursor="Hand" />
            <ToggleButton Content="Focus"
                          Command="{Binding ToggleFocusModeCommand}"
                          IsChecked="{Binding FocusMode, Mode=OneWay}"
                          Padding="12,6" FontSize="11" FontWeight="Medium"
                          Margin="0,0,4,0" Cursor="Hand" />
        </StackPanel>
    </Grid>
</UserControl>
