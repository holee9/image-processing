<UserControl x:Class="ImageProcTest.Views.AnalysisPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="380"
             Background="#14171e">
    <UserControl.Resources>
        <local:StringEqualsConverter x:Key="TabEquals" xmlns:local="clr-namespace:ImageProcTest.Views" />
        <local:StringEqualsConverter x:Key="StringEquals" xmlns:local="clr-namespace:ImageProcTest.Views" />
    </UserControl.Resources>

    <DockPanel>
        <!-- Tab navigation -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Content="Metrics" Tag="metrics"
                    Command="{Binding SwitchAnalysisTabCommand}" CommandParameter="metrics"
                    Padding="6,14" FontSize="11" FontWeight="Medium"
                    Foreground="#f0f2f5" Background="Transparent" BorderThickness="0"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0,0,0,2" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AnalysisTab, FallbackValue=metrics}" Value="metrics">
                                <Setter Property="BorderBrush" Value="#7dd3fc" />
                                <Setter Property="Foreground" Value="#7dd3fc" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Grid.Column="1" Content="Parameters" Tag="parameters"
                    Command="{Binding SwitchAnalysisTabCommand}" CommandParameter="parameters"
                    Padding="6,14" FontSize="11" FontWeight="Medium"
                    Foreground="#f0f2f5" Background="Transparent" BorderThickness="0"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0,0,0,2" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AnalysisTab}" Value="parameters">
                                <Setter Property="BorderBrush" Value="#7dd3fc" />
                                <Setter Property="Foreground" Value="#7dd3fc" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Grid.Column="2" Content="Run-set" Tag="runset"
                    Command="{Binding SwitchAnalysisTabCommand}" CommandParameter="runset"
                    Padding="6,14" FontSize="11" FontWeight="Medium"
                    Foreground="#f0f2f5" Background="Transparent" BorderThickness="0"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0,0,0,2" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AnalysisTab}" Value="runset">
                                <Setter Property="BorderBrush" Value="#7dd3fc" />
                                <Setter Property="Foreground" Value="#7dd3fc" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Grid.Column="3" Content="Log" Tag="log"
                    Command="{Binding SwitchAnalysisTabCommand}" CommandParameter="log"
                    Padding="6,14" FontSize="11" FontWeight="Medium"
                    Foreground="#f0f2f5" Background="Transparent" BorderThickness="0"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0,0,0,2" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AnalysisTab}" Value="log">
                                <Setter Property="BorderBrush" Value="#7dd3fc" />
                                <Setter Property="Foreground" Value="#7dd3fc" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- Separator -->
        <Rectangle DockPanel.Dock="Top" Height="1" Fill="#1AFFFFFF" />

        <!-- Tab content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="12">
                <!-- Metrics tab -->
                <StackPanel Visibility="{Binding AnalysisTab, Converter={StaticResource TabEquals}, ConverterParameter=metrics}">
                    <TextBlock Text="Quantitative Quality" Foreground="#f0f2f5" FontSize="12"
                               FontWeight="SemiBold" Margin="0,0,0,12" />

                    <!-- Metrics table header -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Foreground="#5a5f6a" FontSize="9" Text="METRIC" />
                        <TextBlock Grid.Column="1" Foreground="#7dd3fc" FontSize="9" Text="LANE A" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Foreground="#c4b5fd" FontSize="9" Text="LANE B" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Foreground="#5a5f6a" FontSize="9" Text="Delta" HorizontalAlignment="Right" />
                    </Grid>

                    <Rectangle Height="1" Fill="#1AFFFFFF" Margin="0,0,0,8" />

                    <!-- Placeholder metrics rows -->
                    <ItemsControl>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="50" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Metric}" Foreground="#b0b6c0" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{Binding LaneA}" Foreground="#7dd3fc"
                                               FontSize="11" HorizontalAlignment="Right" FontFamily="Consolas" />
                                    <TextBlock Grid.Column="2" Text="{Binding LaneB}" Foreground="#c4b5fd"
                                               FontSize="11" HorizontalAlignment="Right" FontFamily="Consolas" />
                                    <TextBlock Grid.Column="3" Text="{Binding Delta}" Foreground="#5a5f6a"
                                               FontSize="11" HorizontalAlignment="Right" FontFamily="Consolas" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Metrics populated after pipeline run."
                               Foreground="#5a5f6a" FontSize="10" TextWrapping="Wrap"
                               Margin="0,12,0,0" />
                </StackPanel>

                <!-- Parameters tab -->
                <StackPanel Visibility="{Binding AnalysisTab, Converter={StaticResource TabEquals}, ConverterParameter=parameters}">
                    <TextBlock Text="Calibration Stages" Foreground="#f0f2f5" FontSize="12"
                               FontWeight="SemiBold" Margin="0,0,0,12" />

                    <!-- Offset -->
                    <TextBlock Text="Offset" Foreground="#b0b6c0" FontSize="11" Margin="0,0,0,4" />
                    <UniformGrid Columns="3" Margin="0,0,0,12">
                        <RadioButton Content="Auto" GroupName="Offset" IsChecked="{Binding Settings.OffsetCorrectionMode, Mode=TwoWay, Converter={StaticResource StringEquals}, ConverterParameter=Auto}" Foreground="#8a909c" FontSize="10" />
                        <RadioButton Content="On" GroupName="Offset" IsChecked="{Binding Settings.OffsetCorrectionMode, Mode=TwoWay, Converter={StaticResource StringEquals}, ConverterParameter=On}" Foreground="#8a909c" FontSize="10" />
                        <RadioButton Content="Off" GroupName="Offset" IsChecked="{Binding Settings.OffsetCorrectionMode, Mode=TwoWay, Converter={StaticResource StringEquals}, ConverterParameter=Off}" Foreground="#8a909c" FontSize="10" />
                    </UniformGrid>

                    <!-- Gain -->
                    <TextBlock Text="Gain" Foreground="#b0b6c0" FontSize="11" Margin="0,0,0,4" />
                    <UniformGrid Columns="3" Margin="0,0,0,12">
                        <RadioButton Content="Auto" GroupName="Gain" IsChecked="{Binding Settings.GainCorrectionMode, Mode=TwoWay, Converter={StaticResource StringEquals}, ConverterParameter=Auto}" Foreground="#8a909c" FontSize="10" />
                        <RadioButton Content="On" GroupName="Gain" IsChecked="{Binding Settings.GainCorrectionMode, Mode=TwoWay, Converter={StaticResource StringEquals}, ConverterParameter=On}" Foreground="#8a909c" FontSize="10" />
                        <RadioButton Content="Off" GroupName="Gain" IsChecked="{Binding Settings.GainCorrectionMode, Mode=TwoWay, Converter={StaticResource StringEquals}, ConverterParameter=Off}" Foreground="#8a909c" FontSize="10" />
                    </UniformGrid>

                    <!-- Defect -->
                    <TextBlock Text="Defect" Foreground="#b0b6c0" FontSize="11" Margin="0,0,0,4" />
                    <UniformGrid Columns="3" Margin="0,0,0,12">
                        <RadioButton Content="Auto" GroupName="Defect" IsChecked="{Binding Settings.DefectCorrectionMode, Mode=TwoWay, Converter={StaticResource StringEquals}, ConverterParameter=Auto}" Foreground="#8a909c" FontSize="10" />
                        <RadioButton Content="On" GroupName="Defect" IsChecked="{Binding Settings.DefectCorrectionMode, Mode=TwoWay, Converter={StaticResource StringEquals}, ConverterParameter=On}" Foreground="#8a909c" FontSize="10" />
                        <RadioButton Content="Off" GroupName="Defect" IsChecked="{Binding Settings.DefectCorrectionMode, Mode=TwoWay, Converter={StaticResource StringEquals}, ConverterParameter=Off}" Foreground="#8a909c" FontSize="10" />
                    </UniformGrid>

                    <!-- Ghost -->
                    <TextBlock Text="Ghost" Foreground="#b0b6c0" FontSize="11" Margin="0,0,0,4" />
                    <UniformGrid Columns="3" Margin="0,0,0,12">
                        <RadioButton Content="Auto" GroupName="Ghost" IsChecked="{Binding Settings.GhostCorrectionMode, Mode=TwoWay, Converter={StaticResource StringEquals}, ConverterParameter=Auto}" Foreground="#8a909c" FontSize="10" />
                        <RadioButton Content="On" GroupName="Ghost" IsChecked="{Binding Settings.GhostCorrectionMode, Mode=TwoWay, Converter={StaticResource StringEquals}, ConverterParameter=On}" Foreground="#8a909c" FontSize="10" />
                        <RadioButton Content="Off" GroupName="Ghost" IsChecked="{Binding Settings.GhostCorrectionMode, Mode=TwoWay, Converter={StaticResource StringEquals}, ConverterParameter=Off}" Foreground="#8a909c" FontSize="10" />
                    </UniformGrid>

                    <Rectangle Height="1" Fill="#1AFFFFFF" Margin="0,4,0,12" />

                    <!-- VOI LUT -->
                    <TextBlock Text="VOI LUT" Foreground="#f0f2f5" FontSize="12"
                               FontWeight="SemiBold" Margin="0,0,0,12" />

                    <TextBlock Text="Mode" Foreground="#b0b6c0" FontSize="11" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding VoiLutModeOptions}"
                              SelectedItem="{Binding Settings.VoiLutMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Background="Transparent" Foreground="#f0f2f5"
                              BorderBrush="#1AFFFFFF" FontSize="11"
                              Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Center" Foreground="#b0b6c0" FontSize="11" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Settings.VoiWindowCenter, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#0DFFFFFF" Foreground="#f0f2f5"
                                     BorderBrush="#1AFFFFFF" Padding="6,4" FontSize="11" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Width" Foreground="#b0b6c0" FontSize="11" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Settings.VoiWindowWidth, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#0DFFFFFF" Foreground="#f0f2f5"
                                     BorderBrush="#1AFFFFFF" Padding="6,4" FontSize="11" />
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="#1AFFFFFF" Margin="0,4,0,12" />

                    <!-- Lane B overrides -->
                    <TextBlock Text="Lane B Overrides" Foreground="#c4b5fd" FontSize="12"
                               FontWeight="SemiBold" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Sharpening sigma" Foreground="#b0b6c0" FontSize="11" Margin="0,0,0,4" />
                            <TextBox Text="{Binding LaneBSharpeningSigma, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#0DFFFFFF" Foreground="#f0f2f5"
                                     BorderBrush="#1AFFFFFF" Padding="6,4" FontSize="11" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Denoise strength" Foreground="#b0b6c0" FontSize="11" Margin="0,0,0,4" />
                            <TextBox Text="{Binding LaneBDenoiseStrength, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#0DFFFFFF" Foreground="#f0f2f5"
                                     BorderBrush="#1AFFFFFF" Padding="6,4" FontSize="11" />
                        </StackPanel>
                    </Grid>

                    <Button Content="Reset defaults"
                            Command="{Binding ResetLaneBOverridesCommand}"
                            Background="Transparent" Foreground="#8a909c"
                            BorderBrush="#1AFFFFFF" BorderThickness="1"
                            Padding="12,6" FontSize="10"
                            HorizontalAlignment="Left" Cursor="Hand" />
                </StackPanel>

                <!-- Run-set tab -->
                <StackPanel Visibility="{Binding AnalysisTab, Converter={StaticResource TabEquals}, ConverterParameter=runset}">
                    <TextBlock Text="Run-set Summary" Foreground="#f0f2f5" FontSize="12"
                               FontWeight="SemiBold" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Background="#0DFFFFFF" CornerRadius="6" Padding="12,8" Margin="0,0,6,6">
                            <StackPanel>
                                <TextBlock Text="Passed" Foreground="#5a5f6a" FontSize="9" />
                                <TextBlock Text="{Binding RunSet.Passed, FallbackValue=0}" Foreground="#86efac"
                                           FontSize="20" FontWeight="Bold" FontFamily="Consolas" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#0DFFFFFF" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="Failed" Foreground="#5a5f6a" FontSize="9" />
                                <TextBlock Text="{Binding RunSet.Failed, FallbackValue=0}" Foreground="#fca5a5"
                                           FontSize="20" FontWeight="Bold" FontFamily="Consolas" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Background="#0DFFFFFF" CornerRadius="6" Padding="12,8" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Deferred" Foreground="#5a5f6a" FontSize="9" />
                                <TextBlock Text="{Binding RunSet.Deferred, FallbackValue=0}" Foreground="#fcd34d"
                                           FontSize="20" FontWeight="Bold" FontFamily="Consolas" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Background="#0DFFFFFF" CornerRadius="6" Padding="12,8">
                            <StackPanel>
                                <TextBlock Text="Total" Foreground="#5a5f6a" FontSize="9" />
                                <TextBlock Text="{Binding RunSet.Total, FallbackValue=0}" Foreground="#f0f2f5"
                                           FontSize="20" FontWeight="Bold" FontFamily="Consolas" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Rectangle Height="1" Fill="#1AFFFFFF" Margin="0,4,0,12" />

                    <Button Content="Export evidence bundle"
                            Command="{Binding ExportEvidenceBundleCommand}"
                            Background="#7dd3fc" Foreground="#0c1220"
                            BorderThickness="0" Padding="14,8"
                            FontSize="11" FontWeight="SemiBold"
                            HorizontalAlignment="Stretch" Cursor="Hand" />
                </StackPanel>

                <!-- Log tab -->
                <StackPanel Visibility="{Binding AnalysisTab, Converter={StaticResource TabEquals}, ConverterParameter=log}">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Application Log" Foreground="#f0f2f5" FontSize="12"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Clear"
                                Command="{Binding ClearLogsCommand}"
                                Background="Transparent" Foreground="#8a909c"
                                BorderThickness="0" FontSize="10" Cursor="Hand"
                                Padding="8,2" />
                    </Grid>

                    <ListBox ItemsSource="{Binding Logs}"
                             Background="Transparent" BorderThickness="0"
                             Foreground="#f0f2f5" MaxHeight="600"
                             FontFamily="Consolas" FontSize="11">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                           Foreground="#b0b6c0" Margin="0,2" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="4,2" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
