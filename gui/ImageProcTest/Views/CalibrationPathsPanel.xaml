<UserControl x:Class="ImageProcTest.Views.CalibrationPathsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="CalibrationPathsPanel"
             Width="360"
             Background="#14171e">
    <!--
        #225 row 7 (GUI-C-170). A view over three EXISTING settings and three EXISTING commands; it adds
        no state. The directories are Settings.{Offset,Gain,Defect}CalibrationDirectory, the buttons are
        Browse{Offset,Gain,Defect}CalibrationDirectoryCommand, both of which had no markup at all before
        this panel (measured in GUI-C-65).

        The path text is one-way on purpose: Browse is the writer, so a second, typed path would be a
        second writer on the same setting (the pattern GUI-C-47 took out of Settings.ComparisonMode).

        An empty path shows "(not set)" rather than a blank line: blank reads as "loading" or "broken",
        while the backend treats it as "no calibration directory" (MockXpeBackend autoApplies only when the
        directory is non-empty). The path and its stand-in are two elements, each switched by the SETTING's
        value. A single element whose style triggered on its own Text would depend on the property it sets
        (the first version of this file did that and overflowed the stack while loading).
    -->
    <UserControl.Resources>
        <Style x:Key="PathText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#c8f7c5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <Style x:Key="NotSetText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8b93a7" />
            <Setter Property="Text" Value="(not set)" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="10">
        <TextBlock Text="Calibration paths"
                   Foreground="#e6e9ef"
                   FontWeight="Bold"
                   FontSize="14" />
        <TextBlock AutomationProperties.AutomationId="CalibrationPathsProvenance"
                   Text="Directories the backend loads calibration from. Browse changes the setting; Save Settings stores it."
                   Foreground="#8b93a7"
                   TextWrapping="Wrap"
                   Margin="0,4,0,8" />

        <Border Background="#1b1f29" Padding="8,6" Margin="0,0,0,6">
            <StackPanel>
                <TextBlock Text="Offset" Foreground="#e6e9ef" FontWeight="Bold" />
                <TextBlock x:Name="OffsetCalibrationPathText"
                           AutomationProperties.AutomationId="OffsetCalibrationPathText"
                           Style="{StaticResource PathText}"
                           Text="{Binding Settings.OffsetCalibrationDirectory, Mode=OneWay}" />
                <TextBlock AutomationProperties.AutomationId="OffsetCalibrationNotSet">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource NotSetText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Settings.OffsetCalibrationDirectory}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button AutomationProperties.AutomationId="BrowseOffsetCalibrationButton"
                        Content="Browse..."
                        Command="{Binding BrowseOffsetCalibrationDirectoryCommand}"
                        HorizontalAlignment="Left" Margin="0,4,0,0" Padding="10,2" />
            </StackPanel>
        </Border>
        <Border Background="#1b1f29" Padding="8,6" Margin="0,0,0,6">
            <StackPanel>
                <TextBlock Text="Gain" Foreground="#e6e9ef" FontWeight="Bold" />
                <TextBlock x:Name="GainCalibrationPathText"
                           AutomationProperties.AutomationId="GainCalibrationPathText"
                           Style="{StaticResource PathText}"
                           Text="{Binding Settings.GainCalibrationDirectory, Mode=OneWay}" />
                <TextBlock AutomationProperties.AutomationId="GainCalibrationNotSet">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource NotSetText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Settings.GainCalibrationDirectory}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button AutomationProperties.AutomationId="BrowseGainCalibrationButton"
                        Content="Browse..."
                        Command="{Binding BrowseGainCalibrationDirectoryCommand}"
                        HorizontalAlignment="Left" Margin="0,4,0,0" Padding="10,2" />
            </StackPanel>
        </Border>
        <Border Background="#1b1f29" Padding="8,6" Margin="0,0,0,6">
            <StackPanel>
                <TextBlock Text="Defect" Foreground="#e6e9ef" FontWeight="Bold" />
                <TextBlock x:Name="DefectCalibrationPathText"
                           AutomationProperties.AutomationId="DefectCalibrationPathText"
                           Style="{StaticResource PathText}"
                           Text="{Binding Settings.DefectCalibrationDirectory, Mode=OneWay}" />
                <TextBlock AutomationProperties.AutomationId="DefectCalibrationNotSet">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource NotSetText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Settings.DefectCalibrationDirectory}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button AutomationProperties.AutomationId="BrowseDefectCalibrationButton"
                        Content="Browse..."
                        Command="{Binding BrowseDefectCalibrationDirectoryCommand}"
                        HorizontalAlignment="Left" Margin="0,4,0,0" Padding="10,2" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
