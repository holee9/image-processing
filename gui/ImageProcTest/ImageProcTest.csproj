<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <!-- WinForms types must be used via fully-qualified names to avoid WPF ambiguity -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!--
    #110: the alert display formatter is owned by clients/ImageProcTest (which owns the native
    alert API surface). gui consumes it as linked source rather than a project reference — both
    projects are WinExe and neither is a library, so the file stays in one place with one author.
  -->
  <ItemGroup>
    <Compile Include="..\..\clients\ImageProcTest\Services\AlertDisplayFormatter.cs"
             Link="Services\AlertDisplayFormatter.cs" />
    <!--
      #129/#136: the native DLL search policy, shared rather than re-implemented. gui used to rely on
      the Windows loader (app directory only), so XPE_NATIVE_DIR was inert here while clients obeyed
      it — measured in GUI-C-31.
    -->
    <Compile Include="..\..\clients\ImageProcTest\Diagnostics\NativeSearchPolicy.cs"
             Link="Services\Native\Linked\NativeSearchPolicy.cs" />
    <Compile Include="..\..\clients\ImageProcTest\Diagnostics\XpeCommonLibraryLocator.cs"
             Link="Services\Native\Linked\XpeCommonLibraryLocator.cs" />
    <Compile Include="..\..\clients\ImageProcTest\Diagnostics\NativeModuleLibraryLocator.cs"
             Link="Services\Native\Linked\NativeModuleLibraryLocator.cs" />
    <Compile Include="..\..\clients\ImageProcTest\Diagnostics\NativeDependencyLoader.cs"
             Link="Services\Native\Linked\NativeDependencyLoader.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="help\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="fixtures\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
