<Window x:Class="ImageProcTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ImageProcTest.Controls"
        xmlns:viewModels="clr-namespace:ImageProcTest.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:ImageProcTest.Views"
        xmlns:converters="clr-namespace:ImageProcTest.Converters"
        mc:Ignorable="d"
        Title="{Binding WindowTitle, Mode=OneWay}"
        AutomationProperties.AutomationId="MainWindow"
        AutomationProperties.ItemStatus="{Binding FaultInjectionStatus, Mode=OneWay}"
        Height="920"
        Width="1560"
        MinHeight="720"
        MinWidth="1280">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <viewModels:StringEqualsConverter x:Key="StringEquals" />
        <converters:FocusPanelVisibilityConverter x:Key="FocusPanelVisibility" />
    </Window.Resources>

    <!--
        Comparison-mode key gestures (GUI-C-58, #149 G-2). MENU-001 section 9.3 and 10.1 specify six;
        three are bound here and three are deliberately NOT, because the two documents that MENU-001
        section 10 calls a single source of truth disagree about them:

          F5  Swipe           bound     - MENU-001 9.3, 10.1 and ACCESS-001 5.2 all agree
          F6  Split           bound     - the conflict was decided against ACCESS-001 (6dffce0):
                                          MENU-001 says Split in BOTH 9.3 and 10.1, and the value
                                          ACCESS-001 carried (Difference) also collided with F8.
                                          ACCESS-001 listed only F5 and F6, so that collision was
                                          not visible from inside its own table
          F7  Overlay         bound     - named only by MENU-001; nothing else claims F7
          F8  Difference      bound     - named only by MENU-001; nothing else claims F8
          Ctrl+1 SourceOnly   NOT bound - decided (6dffce0): Ctrl+1 belongs to Zoom 100 percent,
                                          which MENU-001 10.1 and ACCESS-001 5.2 agree on; 9.3 was
                                          the wrong entry
          Ctrl+2 ProcessedOnly NOT bound - its pair has no key, so neither does it

        Source Only and Processed Only reach the user through View -> Compare Mode only. A
        replacement key for them is not this lane's to pick: key assignment is judged together with
        the accessibility navigation and the mnemonics.
    -->
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding SetComparisonModeCommand}" CommandParameter="SwipeVertical" />
        <KeyBinding Key="F6" Command="{Binding SetComparisonModeCommand}" CommandParameter="SplitLocked" />
        <KeyBinding Key="F7" Command="{Binding SetComparisonModeCommand}" CommandParameter="OverlayOpacity" />
        <KeyBinding Key="F8" Command="{Binding SetComparisonModeCommand}" CommandParameter="DifferenceHeatmap" />
    </Window.InputBindings>

    <DockPanel>
        <!-- #175 HAZ-GUI-005 (1): shown while the ACTUAL backend is Mock. No close control on purpose. -->
        <Border DockPanel.Dock="Top"
                AutomationProperties.AutomationId="MockBackendBanner"
                Background="#FFB91C1C"
                Padding="12,6"
                Visibility="{Binding IsMockBackend, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock AutomationProperties.AutomationId="MockBackendBannerText"
                       Text="{Binding MockBackendWarning, Mode=OneWay}"
                       Foreground="White"
                       FontWeight="Bold"
                       TextWrapping="Wrap" />
        </Border>
        <!-- Workbench TopBar (Slice 3) -->
        <views:TopBar DockPanel.Dock="Top" />

        <!-- Workbench AlgorithmBar (Slice 3) -->
        <views:AlgorithmBar DockPanel.Dock="Top" />

        <!-- #225 row 13 (GUI-C-168). Collapsed until the Tools menu opens it; the flag has a reader
             here, which is what the two panel flags below lacked until GUI-C-170. -->
        <views:PipelineDiagnosticsPanel DockPanel.Dock="Right"
                                        Visibility="{Binding ShowPipelineDiagnostics, Converter={StaticResource BoolToVisibility}}" />

        <!-- #225 rows 7 and 8 (GUI-C-170). Each flag is a persisted Settings.* value and the panel is its
             reader. Collapsed by default (MENU-001 §9.2), opened by the View toggle. -->
        <views:CalibrationPathsPanel DockPanel.Dock="Right"
                                     Visibility="{Binding Settings.ShowCalibrationPanel, Converter={StaticResource BoolToVisibility}}" />
        <views:DisplaySettingsPanel DockPanel.Dock="Right"
                                    Visibility="{Binding Settings.ShowDisplayPanel, Converter={StaticResource BoolToVisibility}}" />

        <Menu x:Name="MainMenu"
              AutomationProperties.AutomationId="MainMenu"
              DockPanel.Dock="Top">
            <MenuItem x:Name="FileMenu"
                      AutomationProperties.AutomationId="FileMenu"
                      Header="_File">
                <MenuItem x:Name="OpenRawMenuItem"
                          AutomationProperties.AutomationId="OpenRawMenuItem"
                          Header="_Open Raw..."
                          Command="{Binding LoadImageCommand}" />
                <!-- #225 (GUI-C-160, row 1): the history is persisted with the settings, so this is a
                     live submenu now. Each entry carries its own command (see RecentRawFile) because a
                     RelativeSource binding out of a popup resolves against a different visual tree. -->
                <MenuItem x:Name="OpenRecentMenuItem"
                          AutomationProperties.AutomationId="OpenRecentMenuItem"
                          Header="Open _Recent"
                          ItemsSource="{Binding RecentRawFiles}"
                          IsEnabled="{Binding HasRecentRawFiles}"
                          ToolTip="Raw files this installation has opened, newest first.">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding Path}" />
                            <Setter Property="Command" Value="{Binding OpenCommand}" />
                            <Setter Property="CommandParameter" Value="{Binding Path}" />
                            <Setter Property="AutomationProperties.AutomationId" Value="RecentRawFileMenuItem" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem x:Name="OpenDicomMenuItem"
                          AutomationProperties.AutomationId="OpenDicomMenuItem"
                          Header="Open _DICOM... (Phase 1b)"
                          IsEnabled="False"
                          ToolTip="Real DICOM read/write is owned by xpe_dicom.dll in Phase 1b." />
                <Separator />
                <MenuItem x:Name="SaveSettingsMenuItem"
                          AutomationProperties.AutomationId="SaveSettingsMenuItem"
                          Header="_Save Settings"
                          Command="{Binding SaveSettingsCommand}" />
                <MenuItem x:Name="ExportAutomationReportMenuItem"
                          AutomationProperties.AutomationId="ExportAutomationReportMenuItem"
                          Header="Export _Automation Report"
                          Command="{Binding ExportAutomationReportCommand}" />
                <!-- #225 (GUI-C-163, row 3): the menu item was the ONLY thing missing. It arrived as a
                     placeholder in f8f9bd5 (2026-04-16); the capability landed three weeks later in
                     54a3ae7 (#78) bound to two workbench buttons, and nobody came back to the
                     placeholder. Same command object as those buttons, so the menu cannot drift. -->
                <MenuItem x:Name="ExportEvidenceBundleMenuItem"
                          AutomationProperties.AutomationId="ExportEvidenceBundleMenuItem"
                          Header="Export Evidence _Bundle"
                          Command="{Binding ExportEvidenceBundleCommand}"
                          ToolTip="Zip this run set's evidence directory into evidence/bundles/&lt;RunId&gt;.zip. Same command as the workbench Export bundle button." />
                <Separator />
                <MenuItem x:Name="ExitMenuItem"
                          AutomationProperties.AutomationId="ExitMenuItem"
                          Header="E_xit"
                          Click="ExitMenuItem_OnClick" />
            </MenuItem>

            <MenuItem x:Name="BackendMenu"
                      AutomationProperties.AutomationId="BackendMenu"
                      Header="_Backend">
                <MenuItem x:Name="InitializeBackendMenuItem"
                          AutomationProperties.AutomationId="InitializeBackendMenuItem"
                          Header="_Initialize Backend"
                          Command="{Binding InitializeBackendCommand}" />
                <MenuItem x:Name="ShutdownBackendMenuItem"
                          AutomationProperties.AutomationId="ShutdownBackendMenuItem"
                          Header="_Shutdown Backend"
                          Command="{Binding ShutdownBackendCommand}" />
                <Separator />
                <MenuItem x:Name="BackendModeMenuItem"
                          AutomationProperties.AutomationId="BackendModeMenuItem"
                          Header="Backend _Mode">
                    <!-- #225 (GUI-C-153, row 4): both items are commands now. The check marks follow
                         ActualBackendMode, not the request: asking for Native and silently getting Mock
                         (the factory falls back when the DLLs will not load) must not look like success. -->
                    <MenuItem x:Name="MockBackendModeMenuItem"
                              AutomationProperties.AutomationId="MockBackendModeMenuItem"
                              Header="_Mock"
                              IsCheckable="True"
                              IsChecked="{Binding ActualBackendMode, Mode=OneWay, Converter={StaticResource StringEquals}, ConverterParameter=Mock}"
                              Command="{Binding SetBackendModeCommand}"
                              CommandParameter="Mock"
                              ToolTip="Run without the native DLLs; stages report why they did not run." />
                    <MenuItem x:Name="NativeBackendModeMenuItem"
                              AutomationProperties.AutomationId="NativeBackendModeMenuItem"
                              Header="_Native"
                              IsCheckable="True"
                              IsChecked="{Binding ActualBackendMode, Mode=OneWay, Converter={StaticResource StringEquals}, ConverterParameter=Native}"
                              Command="{Binding SetBackendModeCommand}"
                              CommandParameter="Native"
                              ToolTip="Re-initialise on the native DLLs. Falls back to Mock when they cannot load — the title bar then shows the requested mode next to the actual one." />
                </MenuItem>
                <Separator />
                <MenuItem x:Name="NativeDllDiagnosticsMenuItem"
                          AutomationProperties.AutomationId="NativeDllDiagnosticsMenuItem"
                          Header="Native DLL _Diagnostics"
                          Command="{Binding ShowNativeDiagnosticsCommand}" />
                <MenuItem x:Name="OpenRuntimeLogsMenuItem"
                          AutomationProperties.AutomationId="OpenRuntimeLogsMenuItem"
                          Header="Export Runtime _Logs"
                          Command="{Binding ExportRuntimeLogsCommand}"
                          ToolTip="Write the runtime log to runtime-log.txt under this run set's evidence directory. It does not open a viewer." />
                <!-- #225 (GUI-C-154, row 6): the integration the old tooltip waited for has happened,
                     so this is a command now. It calls the DLLs directly rather than through the
                     backend, because the backend falls back to the mock and would report success. -->
                <MenuItem x:Name="PInvokeSmokeTestMenuItem"
                          AutomationProperties.AutomationId="PInvokeSmokeTestMenuItem"
                          Header="Run P/_Invoke Smoke Test"
                          Command="{Binding RunPInvokeSmokeTestCommand}"
                          ToolTip="Call xpe_common and xpe_display directly and report whether they answered. Fails when the DLLs cannot be loaded." />
            </MenuItem>

            <MenuItem x:Name="ViewMenu"
                      AutomationProperties.AutomationId="ViewMenu"
                      Header="_View">
                <!--
                    #165 (GUI-C-65): Runtime Panel, Raw Settings Panel and Alerts Panel used to sit
                    here. They named panels that the Evaluation Workbench redesign replaced — the
                    menu outlived the layout — so nothing on screen answered to them. Measured in
                    GUI-C-63: pressing one flipped its check and left the UIA descendant count at
                    146, while the Analysis panel's own Log button moved it 146 -> 155. Worse, Reset
                    Layout set the checks back on, which reads as "the panels came back".

                    Removing a control that does nothing is not a loss of function; keeping it is a
                    claim the app cannot honour. MENU-001 §9.2 is being rewritten to match (#165).
                -->
                <!--
                    Phase 1a and 1b (MENU-001 §9.2). Disabled until #225 rows 7 and 8 (GUI-C-170): an enabled
                    toggle for a panel that does not exist is a lie in the present tense, which is why both
                    were enabled until #165 and neither did anything. Each now drives a real panel through a
                    persisted Settings flag, so the toggle is enabled again and its check mark is the
                    panel's actual visibility.
                -->
                <MenuItem x:Name="ShowCalibrationPanelMenuItem"
                          AutomationProperties.AutomationId="ShowCalibrationPanelMenuItem"
                          Header="Calibration Paths Panel"
                          IsCheckable="True"
                          IsChecked="{Binding Settings.ShowCalibrationPanel, Mode=TwoWay}"
                          ToolTip="Show the three calibration directories and their Browse buttons." />
                <MenuItem x:Name="ShowDisplaySettingsPanelMenuItem"
                          AutomationProperties.AutomationId="ShowDisplaySettingsPanelMenuItem"
                          Header="Display Settings Panel"
                          IsCheckable="True"
                          IsChecked="{Binding Settings.ShowDisplayPanel, Mode=TwoWay}"
                          ToolTip="Show the requested VOI settings next to what the last render used." />
                <MenuItem x:Name="ShowLogsPanelMenuItem"
                          AutomationProperties.AutomationId="ShowLogsPanelMenuItem"
                          Header="Logs Panel"
                          IsCheckable="True"
                          IsChecked="{Binding ShowLogsPanel, Mode=TwoWay}" />
                <Separator />
                <MenuItem x:Name="ClearLogsMenuItem"
                          AutomationProperties.AutomationId="ClearLogsMenuItem"
                          Header="Clear _Logs"
                          Command="{Binding ClearLogsCommand}" />
                <MenuItem x:Name="ClearAlertsMenuItem"
                          AutomationProperties.AutomationId="ClearAlertsMenuItem"
                          Header="Clear _Alerts"
                          Command="{Binding ClearAlertsCommand}" />
                <Separator />
                <MenuItem x:Name="ResetLayoutMenuItem"
                          AutomationProperties.AutomationId="ResetLayoutMenuItem"
                          Header="_Reset Layout"
                          Command="{Binding ResetLayoutCommand}" />
                <Separator />
                <MenuItem x:Name="ZoomFitMenuItem"
                          AutomationProperties.AutomationId="ZoomFitMenuItem"
                          Header="Zoom _Fit"
                          Command="{Binding ZoomFitCommand}" />
                <MenuItem x:Name="ZoomActualMenuItem"
                          AutomationProperties.AutomationId="ZoomActualMenuItem"
                          Header="Zoom _100%"
                          Command="{Binding ZoomActualCommand}" />
                <MenuItem x:Name="ZoomInMenuItem"
                          AutomationProperties.AutomationId="ZoomInMenuItem"
                          Header="Zoom _In"
                          Command="{Binding ZoomInCommand}" />
                <MenuItem x:Name="ZoomOutMenuItem"
                          AutomationProperties.AutomationId="ZoomOutMenuItem"
                          Header="Zoom _Out"
                          Command="{Binding ZoomOutCommand}" />
                <Separator />
                <!--
                    View -> Compare Mode (GUI-C-58, #149 G-1/G-3). MENU-001 L62 puts comparison modes
                    in the View menu and section 9.3 names six of them; until now the only way in was
                    the four segmented buttons in ViewportShell, so SourceOnly and ProcessedOnly had
                    no caller at all. Every item goes through SetComparisonModeCommand, the same seam
                    the buttons and the key gestures use.

                    IsChecked is ONE-WAY on purpose. The click already routed through the command; a
                    two-way binding would write the mode a second time, and a second writer on
                    Settings.ComparisonMode is exactly what GUI-C-47 took out.

                    InputGestureText appears only where the gesture is actually bound. F6 joined the
                    bound set once the conflict was decided (6dffce0); Ctrl+1 and Ctrl+2 stay unbound
                    by that same decision, and printing a shortcut that does nothing would be worse
                    than printing none.
                -->
                <MenuItem x:Name="CompareModeMenuItem"
                          AutomationProperties.AutomationId="CompareModeMenuItem"
                          Header="_Compare Mode">
                    <MenuItem x:Name="CompareSwipeMenuItem"
                              AutomationProperties.AutomationId="CompareSwipeMenuItem"
                              Header="_Swipe"
                              InputGestureText="F5"
                              IsCheckable="True"
                              IsChecked="{Binding Settings.ComparisonMode, Mode=OneWay, Converter={StaticResource StringEquals}, ConverterParameter=SwipeVertical}"
                              Command="{Binding SetComparisonModeCommand}"
                              CommandParameter="SwipeVertical" />
                    <MenuItem x:Name="CompareSplitMenuItem"
                              AutomationProperties.AutomationId="CompareSplitMenuItem"
                              Header="Sp_lit"
                              InputGestureText="F6"
                              IsCheckable="True"
                              IsChecked="{Binding Settings.ComparisonMode, Mode=OneWay, Converter={StaticResource StringEquals}, ConverterParameter=SplitLocked}"
                              Command="{Binding SetComparisonModeCommand}"
                              CommandParameter="SplitLocked" />
                    <MenuItem x:Name="CompareOverlayMenuItem"
                              AutomationProperties.AutomationId="CompareOverlayMenuItem"
                              Header="_Overlay"
                              InputGestureText="F7"
                              IsCheckable="True"
                              IsChecked="{Binding Settings.ComparisonMode, Mode=OneWay, Converter={StaticResource StringEquals}, ConverterParameter=OverlayOpacity}"
                              Command="{Binding SetComparisonModeCommand}"
                              CommandParameter="OverlayOpacity" />
                    <MenuItem x:Name="CompareDifferenceMenuItem"
                              AutomationProperties.AutomationId="CompareDifferenceMenuItem"
                              Header="_Difference"
                              InputGestureText="F8"
                              IsCheckable="True"
                              IsChecked="{Binding Settings.ComparisonMode, Mode=OneWay, Converter={StaticResource StringEquals}, ConverterParameter=DifferenceHeatmap}"
                              Command="{Binding SetComparisonModeCommand}"
                              CommandParameter="DifferenceHeatmap" />
                    <Separator />
                    <MenuItem x:Name="CompareSourceOnlyMenuItem"
                              AutomationProperties.AutomationId="CompareSourceOnlyMenuItem"
                              Header="Source O_nly"
                              IsCheckable="True"
                              IsChecked="{Binding Settings.ComparisonMode, Mode=OneWay, Converter={StaticResource StringEquals}, ConverterParameter=SourceOnly}"
                              Command="{Binding SetComparisonModeCommand}"
                              CommandParameter="SourceOnly" />
                    <MenuItem x:Name="CompareProcessedOnlyMenuItem"
                              AutomationProperties.AutomationId="CompareProcessedOnlyMenuItem"
                              Header="_Processed Only"
                              IsCheckable="True"
                              IsChecked="{Binding Settings.ComparisonMode, Mode=OneWay, Converter={StaticResource StringEquals}, ConverterParameter=ProcessedOnly}"
                              Command="{Binding SetComparisonModeCommand}"
                              CommandParameter="ProcessedOnly" />
                </MenuItem>
                <Separator />
                <MenuItem x:Name="ResetComparisonViewMenuItem"
                          AutomationProperties.AutomationId="ResetComparisonViewMenuItem"
                          Header="Reset Comparison _View"
                          Command="{Binding ResetComparisonViewCommand}" />
                <MenuItem x:Name="DetachComparisonViewerMenuItem"
                          AutomationProperties.AutomationId="DetachComparisonViewerMenuItem"
                          Header="_Detach Comparison Viewer"
                          Command="{Binding DetachComparisonViewerCommand}" />
            </MenuItem>

            <MenuItem x:Name="PipelineMenu"
                      AutomationProperties.AutomationId="PipelineMenu"
                      Header="_Pipeline">
                <MenuItem x:Name="ApplyDisplayPipelineMenuItem"
                          AutomationProperties.AutomationId="ApplyDisplayPipelineMenuItem"
                          Header="Apply _Display Pipeline"
                          Command="{Binding ApplyDisplayPipelineCommand}" />
                <Separator />
                <MenuItem x:Name="RunPreprocessingMenuItem"
                          AutomationProperties.AutomationId="RunPreprocessingMenuItem"
                          Header="Run _Preprocessing (Phase 1a)"
                          Command="{Binding RunPreprocessingCommand}"
                          IsEnabled="{Binding CanRunPreprocessing}"
                          ToolTip="Requires the native backend and a calibration set (xpe_calib_fixture_gen)." />
                <MenuItem x:Name="RunDeterministicBaselineMenuItem"
                          AutomationProperties.AutomationId="RunDeterministicBaselineMenuItem"
                          Header="Run _Deterministic Baseline (Phase 1b)"
                          Command="{Binding RunDeterministicBaselineCommand}"
                          IsEnabled="{Binding CanRunDeterministicBaseline}"
                          ToolTip="Runs the fixed Phase 1b chain (preprocess, enhance_basic, display LUTs, DICOM write) twice on the loaded image and reports whether the two outputs are bit-identical. Needs the native backend and a loaded image. Changes no setting." />
                <!-- #225 (GUI-C-184, row 10). The id and the x:Name stay (tests and the three-axis count key on them); the item no
                     longer says "Full Pipeline": today it runs ONE assistive module, bone suppression. The other AI modules
                     and the premium ones are not wired to it. -->
                <MenuItem x:Name="RunFullPipelineMenuItem"
                          AutomationProperties.AutomationId="RunFullPipelineMenuItem"
                          Header="Run _AI Bone Suppression"
                          Command="{Binding RunAiBoneSuppressionCommand}"
                          ToolTip="Runs AI bone suppression (xpe_bone_suppress, worker process) on the loaded frame after the other stages. Needs the native backend and xpe_ai.dll with a model in the AI model directory. If the module fails, the original image is shown and the status line says so; a build without an inference runtime always fails. Other AI and premium modules are not wired to this item." />
                <!-- #225 (GUI-C-154, row 11): stops the render in flight by discarding its result;
                     the native calls inside are synchronous and are not interrupted. -->
                <MenuItem x:Name="StopProcessingMenuItem"
                          AutomationProperties.AutomationId="StopProcessingMenuItem"
                          Header="_Stop Processing"
                          Command="{Binding StopProcessingCommand}"
                          ToolTip="Discard the render in flight. The native call already running is not interrupted; its result is dropped instead of being shown." />
                <Separator />
                <!-- #225 (GUI-C-154, row 12): shows what the last render already reported. It does
                     not time anything itself — a second measurement would disagree with the status bar. -->
                <MenuItem x:Name="StageTimingMenuItem"
                          AutomationProperties.AutomationId="StageTimingMenuItem"
                          Header="Stage _Timing"
                          Command="{Binding ShowStageTimingCommand}"
                          ToolTip="Show the last render's own timings: the work/vm/display split and the chain's per-stage times." />
                <!-- #225 (GUI-C-168, row 13): the traces the old tooltip waited for are what the last
                     render already records (LastChain, IsPreviewStale). A command, not a toggle — the
                     header says "Open" and the item carries no IsCheckable. -->
                <MenuItem x:Name="OpenPipelineDiagnosticsMenuItem"
                          AutomationProperties.AutomationId="OpenPipelineDiagnosticsMenuItem"
                          Header="Open Pipeline _Diagnostics"
                          Command="{Binding OpenPipelineDiagnosticsCommand}"
                          ToolTip="Show what the LAST render recorded per stage. It re-measures nothing, and a stage that was switched off shows no time rather than 0 ms." />
            </MenuItem>

            <MenuItem x:Name="ToolsMenu"
                      AutomationProperties.AutomationId="ToolsMenu"
                      Header="_Tools">
                <MenuItem x:Name="CalibrationSettingsMenuItem"
                          AutomationProperties.AutomationId="CalibrationSettingsMenuItem"
                          Header="_Calibration Settings"
                          Command="{Binding ShowCalibrationSettingsCommand}" />
                <MenuItem x:Name="FixtureManagerMenuItem"
                          AutomationProperties.AutomationId="FixtureManagerMenuItem"
                          Header="_Fixture Manager"
                          Command="{Binding ShowFixtureManagerCommand}" />
                <MenuItem x:Name="ExportEvidenceSnapshotMenuItem"
                          AutomationProperties.AutomationId="ExportEvidenceSnapshotMenuItem"
                          Header="Export _Evidence Snapshot"
                          Command="{Binding ExportAutomationReportCommand}" />
                <!-- #225 (GUI-C-163, row 14). Allowed by lead decision, on a stated boundary: the
                     path is computed by the app, never taken from operator input. -->
                <MenuItem x:Name="OpenEvidenceFolderMenuItem"
                          AutomationProperties.AutomationId="OpenEvidenceFolderMenuItem"
                          Header="Open Evidence _Folder"
                          Command="{Binding OpenEvidenceFolderCommand}"
                          ToolTip="Open this run set's evidence directory in the file browser. Says so on the status bar when the directory does not exist yet." />
                <Separator />
                <!-- #225 (GUI-C-158, row 15): runs gui/ImageProcTest.SelfCheck as a child process.
                     Development-machine only — the runner walks up to the repository root for its
                     fixtures — and it says so in the status bar rather than being disabled. -->
                <MenuItem x:Name="RunSelfCheckMenuItem"
                          AutomationProperties.AutomationId="RunSelfCheckMenuItem"
                          Header="Run _Self-Check"
                          Command="{Binding RunSelfCheckCommand}"
                          ToolTip="Run the GUI-S0 self-check and report its verdict. Needs the repository; about a second." />
                <MenuItem x:Name="RunGuiE2EMenuItem"
                          AutomationProperties.AutomationId="RunGuiE2EMenuItem"
                          Header="Run GUI _E2E"
                          Command="{Binding RunGuiE2ECommand}"
                          ToolTip="Run the GUI E2E runner and report its verdict. Needs the repository; about four seconds." />
                <MenuItem x:Name="BenchmarkRunnerMenuItem"
                          AutomationProperties.AutomationId="BenchmarkRunnerMenuItem"
                          Header="_Benchmark Runner (Phase 1a+)"
                          Command="{Binding RunBenchmarkCommand}"
                          ToolTip="Run CI's benchmark freeze tests with ctest and show its exit code and summary. Needs the repository and a build of the ci-post preset; says how to build it when there is none." />
                <MenuItem x:Name="QaConstancyMenuItem"
                          AutomationProperties.AutomationId="QaConstancyMenuItem"
                          Header="_QA Constancy (Phase 1b+)"
                          IsEnabled="False"
                          ToolTip="Requires QA workflow implementation." />
                <MenuItem x:Name="GsdfCalibrateMenuItem"
                          AutomationProperties.AutomationId="GsdfCalibrateMenuItem"
                          Header="_GSDF Calibrate... (Phase 1b+)"
                          IsEnabled="False"
                          ToolTip="Enabled when validated DICOM PS3.14 luminance calibration workflow exists." />
            </MenuItem>

            <MenuItem x:Name="HelpMenu"
                      AutomationProperties.AutomationId="HelpMenu"
                      Header="_Help">
                <MenuItem x:Name="OpenHelpIndexMenuItem"
                          AutomationProperties.AutomationId="OpenHelpIndexMenuItem"
                          Header="_Help Home"
                          Click="OpenHelpIndexMenuItem_OnClick" />
                <MenuItem x:Name="OpenQuickStartHelpMenuItem"
                          AutomationProperties.AutomationId="OpenQuickStartHelpMenuItem"
                          Header="_Quick Start"
                          Click="OpenQuickStartHelpMenuItem_OnClick" />
                <MenuItem x:Name="OpenScopeHelpMenuItem"
                          AutomationProperties.AutomationId="OpenScopeHelpMenuItem"
                          Header="_Scope and Limitations"
                          Click="OpenScopeHelpMenuItem_OnClick" />
                <MenuItem x:Name="OpenCurrentWorkflowHelpMenuItem"
                          AutomationProperties.AutomationId="OpenCurrentWorkflowHelpMenuItem"
                          Header="_Current Workflow Help"
                          ToolTip="Opens help for the current GUI-S0 workflow."
                          Click="OpenCurrentWorkflowHelpMenuItem_OnClick" />
                <Separator />
                <!-- #225 (GUI-C-169, row 20). The header no longer says DocFX: measured on the last green
                     docs-generate run, the DocFX output holds 5 conceptual pages and NO API pages, so a
                     menu that opened it under this name would show something empty as the reference. -->
                <MenuItem x:Name="OpenApiReferenceMenuItem"
                          AutomationProperties.AutomationId="OpenApiReferenceMenuItem"
                          Header="_API Reference (Doxygen)"
                          Command="{Binding OpenApiReferenceCommand}"
                          ToolTip="Open the generated native API reference from docs/help/generated. If it has not been generated, the status bar says how. DocFX is not offered: its generated output currently has no API pages." />
                <!-- #225 (GUI-C-181, row 21). Opens the page DocFX renders from docs/help/content/troubleshooting.md, the
                     way row 20 opens Doxygen's. The old header said "(Phase 1b)" and the old tooltip waited for
                     "deterministic baseline troubleshooting pages"; the page that exists is the operator troubleshooting
                     guide, and the tooltip now says what the item does. -->
                <MenuItem x:Name="OpenTroubleshootingMenuItem"
                          AutomationProperties.AutomationId="OpenTroubleshootingMenuItem"
                          Header="_Troubleshooting"
                          Command="{Binding OpenTroubleshootingCommand}"
                          ToolTip="Open the generated Troubleshooting page (DocFX output under docs/help/generated/docfx). If it has not been generated, the status bar says how." />
                <Separator />
                <MenuItem x:Name="AboutBuildInfoMenuItem"
                          AutomationProperties.AutomationId="AboutBuildInfoMenuItem"
                          Header="_About / Build Info"
                          Click="AboutBuildInfoMenuItem_OnClick" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem AutomationProperties.AutomationId="StatusBarText"
                           Content="{Binding StatusText}" />
            <Separator />
            <StatusBarItem AutomationProperties.AutomationId="ChainStatusText"
                           Content="{Binding ChainStatus}" />
            <Separator />
            <StatusBarItem x:Name="RuntimeCommonVersionText"
                           AutomationProperties.AutomationId="RuntimeCommonVersionText"
                           Content="{Binding RuntimeVersionSummary}" />
        </StatusBar>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button x:Name="InitializeBackendButton"
                        AutomationProperties.AutomationId="InitializeBackendButton"
                        Command="{Binding InitializeBackendCommand}"
                        Content="Initialize Backend" />
                <Button x:Name="ShutdownBackendButton"
                        AutomationProperties.AutomationId="ShutdownBackendButton"
                        Command="{Binding ShutdownBackendCommand}"
                        Content="Shutdown Backend" />
                <Separator />
                <Button x:Name="LoadRawImageButton"
                        AutomationProperties.AutomationId="LoadRawImageButton"
                        Command="{Binding LoadImageCommand}"
                        Content="Load Raw Image" />
                <Button x:Name="SaveSettingsButton"
                        AutomationProperties.AutomationId="SaveSettingsButton"
                        Command="{Binding SaveSettingsCommand}"
                        Content="Save Settings" />
                <Separator />
                <!--
                  #10 / GUI-C-35: body-part preset selector. It sits in the toolbar rather than the
                  Analysis panel because that panel's contents live in tabs, and WPF does not put a
                  tab's children in the UIA tree until the tab is selected (measured in GUI-C-34).
                -->
                <TextBlock Text="Body Part" VerticalAlignment="Center" Margin="4,0,6,0" />
                <ComboBox x:Name="BodyPartSelector"
                          AutomationProperties.AutomationId="BodyPartSelector"
                          ItemsSource="{Binding BodyPartOptions}"
                          SelectedItem="{Binding SelectedBodyPart, Mode=TwoWay}"
                          MinWidth="110" />
                <Separator />
                <Button x:Name="ClearLogsButton"
                        AutomationProperties.AutomationId="ClearLogsButton"
                        Command="{Binding ClearLogsCommand}"
                        Content="Clear Logs" />
                <Button x:Name="ClearAlertsButton"
                        AutomationProperties.AutomationId="ClearAlertsButton"
                        Command="{Binding ClearAlertsCommand}"
                        Content="Clear Alerts" />
            </ToolBar>
        </ToolBarTray>

        <!-- #225 row 10 (GUI-C-185, 185b): the AI worker switched off for the session, or the AI session that could not be
             started. Shown ONLY while the module reports the first (xpe_ai_worker_state) or the last start failed, so it stays when
             the alert has scrolled out of the queue; collapsed otherwise, which also takes it out of the automation tree. The
             restart button sits with it and stays after a failed restart.

             GUI-C-191: this row is NOT inside the ToolBar above. A ToolBar sends the items that do not fit its width to an overflow
             popup, and an item there is neither on screen nor in the UI Automation tree. The panel was the toolbar's LAST item and
             about 700 px wide; on the first native run the module reported the worker off and no banner could be found, because it was
             in the overflow. A notice that says images are being returned unchanged must not be one click away. -->
        <Border DockPanel.Dock="Top" Background="#1AB45309" Padding="8,3"
                AutomationProperties.AutomationId="AiWorkerPanel">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AiWorkerMarkVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel LastChildFill="True">
                <Button x:Name="AiRestartButton"
                        DockPanel.Dock="Right" Margin="8,0,0,0" Padding="8,1"
                        AutomationProperties.AutomationId="AiRestartButton"
                        Command="{Binding RestartAiSessionCommand}"
                        Content="Restart AI"
                        ToolTip="Shuts the AI module down and starts it again: a new session with a clean failure count." />
                <TextBlock x:Name="AiWorkerBanner"
                           AutomationProperties.AutomationId="AiWorkerBanner"
                           Text="{Binding AiWorkerBannerText}"
                           Foreground="#b45309" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           ToolTip="{Binding AiWorkerBannerText}" />
            </DockPanel>
        </Border>

        <!-- Workbench Study Queue (Slice 5) -->
        <views:StudyQueue DockPanel.Dock="Left"
                          AutomationProperties.AutomationId="StudyQueue">
            <views:StudyQueue.Visibility>
                <MultiBinding Converter="{StaticResource FocusPanelVisibility}">
                    <Binding Path="FocusMode" />
                    <Binding Path="LeftPanelOpen" />
                </MultiBinding>
            </views:StudyQueue.Visibility>
        </views:StudyQueue>

        <!-- Workbench Verdict Bar (Slice 6) -->
        <views:VerdictBar DockPanel.Dock="Bottom"
                          AutomationProperties.AutomationId="VerdictBar" />

        <!-- Workbench Analysis Panel (Slice 7) -->
        <views:AnalysisPanel DockPanel.Dock="Right"
                             AutomationProperties.AutomationId="AnalysisPanel">
            <views:AnalysisPanel.Visibility>
                <MultiBinding Converter="{StaticResource FocusPanelVisibility}">
                    <Binding Path="FocusMode" />
                    <Binding Path="RightPanelOpen" />
                </MultiBinding>
            </views:AnalysisPanel.Visibility>
        </views:AnalysisPanel>

        <Grid Margin="0">
            <!--
                #149 G-6: the selected comparison mode is readable from the automation tree.
                HelpText is metadata — it is never rendered, so nothing on screen changes — and it
                binds straight to Settings.ComparisonMode, with no second writer in between. That
                last property is the point: GUI-C-46 tried three observation points and the one that
                looked most promising (the opacity slider) sat downstream of a separate assignment,
                so a falsification that removed the setting write left the suite green.
            -->
            <views:ViewportShell AutomationProperties.AutomationId="ViewportShell"
                                 AutomationProperties.HelpText="{Binding Settings.ComparisonMode}" />
        </Grid>
    </DockPanel>
</Window>
