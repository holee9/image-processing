<Window x:Class="ImageProcTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ImageProcTest.Controls"
        xmlns:viewModels="clr-namespace:ImageProcTest.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:ImageProcTest.Views"
        xmlns:converters="clr-namespace:ImageProcTest.Converters"
        mc:Ignorable="d"
        Title="ImageProcTest GUI-S0"
        Height="920"
        Width="1560"
        MinHeight="720"
        MinWidth="1280">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <viewModels:StringEqualsConverter x:Key="StringEquals" />
        <converters:FocusPanelVisibilityConverter x:Key="FocusPanelVisibility" />
    </Window.Resources>

    <DockPanel>
        <!-- Workbench TopBar (Slice 3) -->
        <views:TopBar DockPanel.Dock="Top" />

        <!-- Workbench AlgorithmBar (Slice 3) -->
        <views:AlgorithmBar DockPanel.Dock="Top" />

        <Menu x:Name="MainMenu"
              AutomationProperties.AutomationId="MainMenu"
              DockPanel.Dock="Top">
            <MenuItem x:Name="FileMenu"
                      AutomationProperties.AutomationId="FileMenu"
                      Header="_File">
                <MenuItem x:Name="OpenRawMenuItem"
                          AutomationProperties.AutomationId="OpenRawMenuItem"
                          Header="_Open Raw..."
                          Command="{Binding LoadImageCommand}" />
                <MenuItem x:Name="OpenRecentMenuItem"
                          AutomationProperties.AutomationId="OpenRecentMenuItem"
                          Header="Open _Recent"
                          IsEnabled="False"
                          ToolTip="Enabled when recent file history is persisted." />
                <MenuItem x:Name="OpenDicomMenuItem"
                          AutomationProperties.AutomationId="OpenDicomMenuItem"
                          Header="Open _DICOM... (Phase 1b)"
                          IsEnabled="False"
                          ToolTip="Real DICOM read/write is owned by xpe_dicom.dll in Phase 1b." />
                <Separator />
                <MenuItem x:Name="SaveSettingsMenuItem"
                          AutomationProperties.AutomationId="SaveSettingsMenuItem"
                          Header="_Save Settings"
                          Command="{Binding SaveSettingsCommand}" />
                <MenuItem x:Name="ExportAutomationReportMenuItem"
                          AutomationProperties.AutomationId="ExportAutomationReportMenuItem"
                          Header="Export _Automation Report"
                          Command="{Binding ExportAutomationReportCommand}" />
                <MenuItem x:Name="ExportEvidenceBundleMenuItem"
                          AutomationProperties.AutomationId="ExportEvidenceBundleMenuItem"
                          Header="Export Evidence _Bundle (Phase 1a+)"
                          IsEnabled="False"
                          ToolTip="Enabled when deterministic run artifacts can be packaged as a review bundle." />
                <Separator />
                <MenuItem x:Name="ExitMenuItem"
                          AutomationProperties.AutomationId="ExitMenuItem"
                          Header="E_xit"
                          Click="ExitMenuItem_OnClick" />
            </MenuItem>

            <MenuItem x:Name="BackendMenu"
                      AutomationProperties.AutomationId="BackendMenu"
                      Header="_Backend">
                <MenuItem x:Name="InitializeBackendMenuItem"
                          AutomationProperties.AutomationId="InitializeBackendMenuItem"
                          Header="_Initialize Backend"
                          Command="{Binding InitializeBackendCommand}" />
                <MenuItem x:Name="ShutdownBackendMenuItem"
                          AutomationProperties.AutomationId="ShutdownBackendMenuItem"
                          Header="_Shutdown Backend"
                          Command="{Binding ShutdownBackendCommand}" />
                <Separator />
                <MenuItem x:Name="BackendModeMenuItem"
                          AutomationProperties.AutomationId="BackendModeMenuItem"
                          Header="Backend _Mode">
                    <MenuItem x:Name="MockBackendModeMenuItem"
                              AutomationProperties.AutomationId="MockBackendModeMenuItem"
                              Header="_Mock"
                              IsCheckable="True"
                              IsChecked="True" />
                    <MenuItem x:Name="NativeBackendModeMenuItem"
                              AutomationProperties.AutomationId="NativeBackendModeMenuItem"
                              Header="_Native (SPRINT-P0-07)"
                              IsCheckable="True"
                              IsEnabled="False"
                              ToolTip="Native backend activation starts after RealXpeBackend and P/Invoke integration." />
                </MenuItem>
                <Separator />
                <MenuItem x:Name="NativeDllDiagnosticsMenuItem"
                          AutomationProperties.AutomationId="NativeDllDiagnosticsMenuItem"
                          Header="Native DLL _Diagnostics"
                          Command="{Binding ShowNativeDiagnosticsCommand}" />
                <MenuItem x:Name="OpenRuntimeLogsMenuItem"
                          AutomationProperties.AutomationId="OpenRuntimeLogsMenuItem"
                          Header="Open Runtime _Logs (Phase 1a+)"
                          IsEnabled="False"
                          ToolTip="Enabled when persistent runtime log export is available." />
                <MenuItem x:Name="PInvokeSmokeTestMenuItem"
                          AutomationProperties.AutomationId="PInvokeSmokeTestMenuItem"
                          Header="Run P/_Invoke Smoke Test (SPRINT-P0-07)"
                          IsEnabled="False"
                          ToolTip="Requires xpe_common.dll and RealXpeBackend integration." />
            </MenuItem>

            <MenuItem x:Name="ViewMenu"
                      AutomationProperties.AutomationId="ViewMenu"
                      Header="_View">
                <MenuItem x:Name="ShowRuntimePanelMenuItem"
                          AutomationProperties.AutomationId="ShowRuntimePanelMenuItem"
                          Header="Runtime Panel"
                          IsCheckable="True"
                          IsChecked="{Binding ShowRuntimePanel, Mode=TwoWay}" />
                <MenuItem x:Name="ShowRawSettingsPanelMenuItem"
                          AutomationProperties.AutomationId="ShowRawSettingsPanelMenuItem"
                          Header="Raw Settings Panel"
                          IsCheckable="True"
                          IsChecked="{Binding ShowRawSettingsPanel, Mode=TwoWay}" />
                <MenuItem x:Name="ShowCalibrationPanelMenuItem"
                          AutomationProperties.AutomationId="ShowCalibrationPanelMenuItem"
                          Header="Calibration Paths Panel"
                          IsCheckable="True"
                          IsChecked="{Binding ShowCalibrationPanel, Mode=TwoWay}" />
                <MenuItem x:Name="ShowDisplaySettingsPanelMenuItem"
                          AutomationProperties.AutomationId="ShowDisplaySettingsPanelMenuItem"
                          Header="Display Settings Panel"
                          IsCheckable="True"
                          IsChecked="{Binding Settings.ShowDisplayPanel, Mode=TwoWay}" />
                <MenuItem x:Name="ShowImageSummaryPanelMenuItem"
                          AutomationProperties.AutomationId="ShowImageSummaryPanelMenuItem"
                          Header="Image Summary Panel"
                          IsCheckable="True"
                          IsChecked="{Binding ShowImageSummaryPanel, Mode=TwoWay}" />
                <MenuItem x:Name="ShowMetadataPanelMenuItem"
                          AutomationProperties.AutomationId="ShowMetadataPanelMenuItem"
                          Header="Metadata / Notes Panel"
                          IsCheckable="True"
                          IsChecked="{Binding ShowMetadataPanel, Mode=TwoWay}" />
                <MenuItem x:Name="ShowLogsPanelMenuItem"
                          AutomationProperties.AutomationId="ShowLogsPanelMenuItem"
                          Header="Logs Panel"
                          IsCheckable="True"
                          IsChecked="{Binding ShowLogsPanel, Mode=TwoWay}" />
                <MenuItem x:Name="ShowAlertsPanelMenuItem"
                          AutomationProperties.AutomationId="ShowAlertsPanelMenuItem"
                          Header="Alerts Panel"
                          IsCheckable="True"
                          IsChecked="{Binding ShowAlertsPanel, Mode=TwoWay}" />
                <Separator />
                <MenuItem x:Name="ClearLogsMenuItem"
                          AutomationProperties.AutomationId="ClearLogsMenuItem"
                          Header="Clear _Logs"
                          Command="{Binding ClearLogsCommand}" />
                <MenuItem x:Name="ClearAlertsMenuItem"
                          AutomationProperties.AutomationId="ClearAlertsMenuItem"
                          Header="Clear _Alerts"
                          Command="{Binding ClearAlertsCommand}" />
                <Separator />
                <MenuItem x:Name="ResetLayoutMenuItem"
                          AutomationProperties.AutomationId="ResetLayoutMenuItem"
                          Header="_Reset Layout"
                          Command="{Binding ResetLayoutCommand}" />
                <Separator />
                <MenuItem x:Name="ZoomFitMenuItem"
                          AutomationProperties.AutomationId="ZoomFitMenuItem"
                          Header="Zoom _Fit"
                          Command="{Binding ZoomFitCommand}" />
                <MenuItem x:Name="ZoomActualMenuItem"
                          AutomationProperties.AutomationId="ZoomActualMenuItem"
                          Header="Zoom _100%"
                          Command="{Binding ZoomActualCommand}" />
                <MenuItem x:Name="ZoomInMenuItem"
                          AutomationProperties.AutomationId="ZoomInMenuItem"
                          Header="Zoom _In"
                          Command="{Binding ZoomInCommand}" />
                <MenuItem x:Name="ZoomOutMenuItem"
                          AutomationProperties.AutomationId="ZoomOutMenuItem"
                          Header="Zoom _Out"
                          Command="{Binding ZoomOutCommand}" />
                <MenuItem x:Name="ResetComparisonViewMenuItem"
                          AutomationProperties.AutomationId="ResetComparisonViewMenuItem"
                          Header="Reset Comparison _View"
                          Command="{Binding ResetComparisonViewCommand}" />
                <MenuItem x:Name="DetachComparisonViewerMenuItem"
                          AutomationProperties.AutomationId="DetachComparisonViewerMenuItem"
                          Header="_Detach Comparison Viewer"
                          Command="{Binding DetachComparisonViewerCommand}" />
            </MenuItem>

            <MenuItem x:Name="PipelineMenu"
                      AutomationProperties.AutomationId="PipelineMenu"
                      Header="_Pipeline">
                <MenuItem x:Name="ApplyDisplayPipelineMenuItem"
                          AutomationProperties.AutomationId="ApplyDisplayPipelineMenuItem"
                          Header="Apply _Display Pipeline"
                          Command="{Binding ApplyDisplayPipelineCommand}" />
                <Separator />
                <MenuItem x:Name="RunPreprocessingMenuItem"
                          AutomationProperties.AutomationId="RunPreprocessingMenuItem"
                          Header="Run _Preprocessing (Phase 1a)"
                          IsEnabled="False"
                          ToolTip="Requires xpe_preprocess.dll." />
                <MenuItem x:Name="RunDeterministicBaselineMenuItem"
                          AutomationProperties.AutomationId="RunDeterministicBaselineMenuItem"
                          Header="Run _Deterministic Baseline (Phase 1b)"
                          IsEnabled="False"
                          ToolTip="Requires preprocess, enhance_basic, display, and dicom modules." />
                <MenuItem x:Name="RunFullPipelineMenuItem"
                          AutomationProperties.AutomationId="RunFullPipelineMenuItem"
                          Header="Run _Full Pipeline (Phase 2/3)"
                          IsEnabled="False"
                          ToolTip="Requires optional premium and assistive modules." />
                <MenuItem x:Name="StopProcessingMenuItem"
                          AutomationProperties.AutomationId="StopProcessingMenuItem"
                          Header="_Stop Processing"
                          IsEnabled="False"
                          ToolTip="Enabled after a real processing run command exists." />
                <Separator />
                <MenuItem x:Name="StageTimingMenuItem"
                          AutomationProperties.AutomationId="StageTimingMenuItem"
                          Header="Stage _Timing"
                          IsEnabled="False"
                          ToolTip="Enabled when real pipeline timing evidence is available." />
                <MenuItem x:Name="OpenPipelineDiagnosticsMenuItem"
                          AutomationProperties.AutomationId="OpenPipelineDiagnosticsMenuItem"
                          Header="Open Pipeline _Diagnostics (Phase 1a+)"
                          IsEnabled="False"
                          ToolTip="Enabled when pipeline execution traces and timing diagnostics exist." />
            </MenuItem>

            <MenuItem x:Name="ToolsMenu"
                      AutomationProperties.AutomationId="ToolsMenu"
                      Header="_Tools">
                <MenuItem x:Name="CalibrationSettingsMenuItem"
                          AutomationProperties.AutomationId="CalibrationSettingsMenuItem"
                          Header="_Calibration Settings"
                          Command="{Binding ShowCalibrationSettingsCommand}" />
                <MenuItem x:Name="FixtureManagerMenuItem"
                          AutomationProperties.AutomationId="FixtureManagerMenuItem"
                          Header="_Fixture Manager"
                          Command="{Binding ShowFixtureManagerCommand}" />
                <MenuItem x:Name="ExportEvidenceSnapshotMenuItem"
                          AutomationProperties.AutomationId="ExportEvidenceSnapshotMenuItem"
                          Header="Export _Evidence Snapshot"
                          Command="{Binding ExportAutomationReportCommand}" />
                <MenuItem x:Name="OpenEvidenceFolderMenuItem"
                          AutomationProperties.AutomationId="OpenEvidenceFolderMenuItem"
                          Header="Open Evidence _Folder (Phase 1a+)"
                          IsEnabled="False"
                          ToolTip="Enabled when the evidence artifact directory is managed by the app." />
                <Separator />
                <MenuItem x:Name="RunSelfCheckMenuItem"
                          AutomationProperties.AutomationId="RunSelfCheckMenuItem"
                          Header="Run _Self-Check"
                          IsEnabled="False"
                          ToolTip="Available through the current test runner; in-app launch is a later tools command." />
                <MenuItem x:Name="RunGuiE2EMenuItem"
                          AutomationProperties.AutomationId="RunGuiE2EMenuItem"
                          Header="Run GUI _E2E"
                          IsEnabled="False"
                          ToolTip="Available through the current test runner; in-app launch is a later tools command." />
                <MenuItem x:Name="BenchmarkRunnerMenuItem"
                          AutomationProperties.AutomationId="BenchmarkRunnerMenuItem"
                          Header="_Benchmark Runner (Phase 1a+)"
                          IsEnabled="False"
                          ToolTip="Requires benchmark manifests and native module execution." />
                <MenuItem x:Name="QaConstancyMenuItem"
                          AutomationProperties.AutomationId="QaConstancyMenuItem"
                          Header="_QA Constancy (Phase 1b+)"
                          IsEnabled="False"
                          ToolTip="Requires QA workflow implementation." />
                <MenuItem x:Name="GsdfCalibrateMenuItem"
                          AutomationProperties.AutomationId="GsdfCalibrateMenuItem"
                          Header="_GSDF Calibrate... (Phase 1b+)"
                          IsEnabled="False"
                          ToolTip="Enabled when validated DICOM PS3.14 luminance calibration workflow exists." />
            </MenuItem>

            <MenuItem x:Name="HelpMenu"
                      AutomationProperties.AutomationId="HelpMenu"
                      Header="_Help">
                <MenuItem x:Name="OpenHelpIndexMenuItem"
                          AutomationProperties.AutomationId="OpenHelpIndexMenuItem"
                          Header="_Help Home"
                          Click="OpenHelpIndexMenuItem_OnClick" />
                <MenuItem x:Name="OpenQuickStartHelpMenuItem"
                          AutomationProperties.AutomationId="OpenQuickStartHelpMenuItem"
                          Header="_Quick Start"
                          Click="OpenQuickStartHelpMenuItem_OnClick" />
                <MenuItem x:Name="OpenScopeHelpMenuItem"
                          AutomationProperties.AutomationId="OpenScopeHelpMenuItem"
                          Header="_Scope and Limitations"
                          Click="OpenScopeHelpMenuItem_OnClick" />
                <MenuItem x:Name="OpenCurrentWorkflowHelpMenuItem"
                          AutomationProperties.AutomationId="OpenCurrentWorkflowHelpMenuItem"
                          Header="_Current Workflow Help"
                          ToolTip="Opens help for the current GUI-S0 workflow."
                          Click="OpenCurrentWorkflowHelpMenuItem_OnClick" />
                <Separator />
                <MenuItem x:Name="OpenApiReferenceMenuItem"
                          AutomationProperties.AutomationId="OpenApiReferenceMenuItem"
                          Header="_API Reference (DocFX/Doxygen)"
                          IsEnabled="False"
                          ToolTip="Enabled when generated API reference is packaged." />
                <MenuItem x:Name="OpenTroubleshootingMenuItem"
                          AutomationProperties.AutomationId="OpenTroubleshootingMenuItem"
                          Header="_Troubleshooting (Phase 1b)"
                          IsEnabled="False"
                          ToolTip="Enabled when deterministic baseline troubleshooting pages are packaged." />
                <Separator />
                <MenuItem x:Name="AboutBuildInfoMenuItem"
                          AutomationProperties.AutomationId="AboutBuildInfoMenuItem"
                          Header="_About / Build Info"
                          Click="AboutBuildInfoMenuItem_OnClick" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem AutomationProperties.AutomationId="StatusBarText"
                           Content="{Binding StatusText}" />
        </StatusBar>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button x:Name="InitializeBackendButton"
                        AutomationProperties.AutomationId="InitializeBackendButton"
                        Command="{Binding InitializeBackendCommand}"
                        Content="Initialize Backend" />
                <Button x:Name="ShutdownBackendButton"
                        AutomationProperties.AutomationId="ShutdownBackendButton"
                        Command="{Binding ShutdownBackendCommand}"
                        Content="Shutdown Backend" />
                <Separator />
                <Button x:Name="LoadRawImageButton"
                        AutomationProperties.AutomationId="LoadRawImageButton"
                        Command="{Binding LoadImageCommand}"
                        Content="Load Raw Image" />
                <Button x:Name="SaveSettingsButton"
                        AutomationProperties.AutomationId="SaveSettingsButton"
                        Command="{Binding SaveSettingsCommand}"
                        Content="Save Settings" />
                <Separator />
                <Button x:Name="ClearLogsButton"
                        AutomationProperties.AutomationId="ClearLogsButton"
                        Command="{Binding ClearLogsCommand}"
                        Content="Clear Logs" />
                <Button x:Name="ClearAlertsButton"
                        AutomationProperties.AutomationId="ClearAlertsButton"
                        Command="{Binding ClearAlertsCommand}"
                        Content="Clear Alerts" />
            </ToolBar>
        </ToolBarTray>

        <!-- Workbench Study Queue (Slice 5) -->
        <views:StudyQueue DockPanel.Dock="Left"
                          AutomationProperties.AutomationId="StudyQueue">
            <views:StudyQueue.Visibility>
                <MultiBinding Converter="{StaticResource FocusPanelVisibility}">
                    <Binding Path="FocusMode" />
                    <Binding Path="LeftPanelOpen" />
                </MultiBinding>
            </views:StudyQueue.Visibility>
        </views:StudyQueue>

        <!-- Workbench Verdict Bar (Slice 6) -->
        <views:VerdictBar DockPanel.Dock="Bottom"
                          AutomationProperties.AutomationId="VerdictBar" />

        <!-- Workbench Analysis Panel (Slice 7) -->
        <views:AnalysisPanel DockPanel.Dock="Right"
                             AutomationProperties.AutomationId="AnalysisPanel">
            <views:AnalysisPanel.Visibility>
                <MultiBinding Converter="{StaticResource FocusPanelVisibility}">
                    <Binding Path="FocusMode" />
                    <Binding Path="RightPanelOpen" />
                </MultiBinding>
            </views:AnalysisPanel.Visibility>
        </views:AnalysisPanel>

        <Grid Margin="0">
            <views:ViewportShell AutomationProperties.AutomationId="ViewportShell" />
        </Grid>
    </DockPanel>
</Window>
