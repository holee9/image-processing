<Window x:Class="ImageProcTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ImageProcTest.Controls"
        xmlns:viewModels="clr-namespace:ImageProcTest.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ImageProcTest GUI-S0"
        Height="920"
        Width="1560"
        MinHeight="720"
        MinWidth="1280">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <viewModels:StringEqualsConverter x:Key="StringEquals" />
    </Window.Resources>

    <DockPanel>
        <Menu x:Name="MainMenu"
              AutomationProperties.AutomationId="MainMenu"
              DockPanel.Dock="Top">
            <MenuItem x:Name="FileMenu"
                      AutomationProperties.AutomationId="FileMenu"
                      Header="_File">
                <MenuItem x:Name="OpenRawMenuItem"
                          AutomationProperties.AutomationId="OpenRawMenuItem"
                          Header="_Open Raw..."
                          Command="{Binding LoadImageCommand}" />
                <MenuItem x:Name="OpenRecentMenuItem"
                          AutomationProperties.AutomationId="OpenRecentMenuItem"
                          Header="Open _Recent"
                          IsEnabled="False"
                          ToolTip="Enabled when recent file history is persisted." />
                <MenuItem x:Name="OpenDicomMenuItem"
                          AutomationProperties.AutomationId="OpenDicomMenuItem"
                          Header="Open _DICOM... (Phase 1b)"
                          IsEnabled="False"
                          ToolTip="Real DICOM read/write is owned by xpe_dicom.dll in Phase 1b." />
                <Separator />
                <MenuItem x:Name="SaveSettingsMenuItem"
                          AutomationProperties.AutomationId="SaveSettingsMenuItem"
                          Header="_Save Settings"
                          Command="{Binding SaveSettingsCommand}" />
                <MenuItem x:Name="ExportAutomationReportMenuItem"
                          AutomationProperties.AutomationId="ExportAutomationReportMenuItem"
                          Header="Export _Automation Report"
                          Command="{Binding ExportAutomationReportCommand}" />
                <MenuItem x:Name="ExportEvidenceBundleMenuItem"
                          AutomationProperties.AutomationId="ExportEvidenceBundleMenuItem"
                          Header="Export Evidence _Bundle (Phase 1a+)"
                          IsEnabled="False"
                          ToolTip="Enabled when deterministic run artifacts can be packaged as a review bundle." />
                <Separator />
                <MenuItem x:Name="ExitMenuItem"
                          AutomationProperties.AutomationId="ExitMenuItem"
                          Header="E_xit"
                          Click="ExitMenuItem_OnClick" />
            </MenuItem>

            <MenuItem x:Name="BackendMenu"
                      AutomationProperties.AutomationId="BackendMenu"
                      Header="_Backend">
                <MenuItem x:Name="InitializeBackendMenuItem"
                          AutomationProperties.AutomationId="InitializeBackendMenuItem"
                          Header="_Initialize Backend"
                          Command="{Binding InitializeBackendCommand}" />
                <MenuItem x:Name="ShutdownBackendMenuItem"
                          AutomationProperties.AutomationId="ShutdownBackendMenuItem"
                          Header="_Shutdown Backend"
                          Command="{Binding ShutdownBackendCommand}" />
                <Separator />
                <MenuItem x:Name="BackendModeMenuItem"
                          AutomationProperties.AutomationId="BackendModeMenuItem"
                          Header="Backend _Mode">
                    <MenuItem x:Name="MockBackendModeMenuItem"
                              AutomationProperties.AutomationId="MockBackendModeMenuItem"
                              Header="_Mock"
                              IsCheckable="True"
                              IsChecked="True" />
                    <MenuItem x:Name="NativeBackendModeMenuItem"
                              AutomationProperties.AutomationId="NativeBackendModeMenuItem"
                              Header="_Native (SPRINT-P0-07)"
                              IsCheckable="True"
                              IsEnabled="False"
                              ToolTip="Native backend activation starts after RealXpeBackend and P/Invoke integration." />
                </MenuItem>
                <Separator />
                <MenuItem x:Name="NativeDllDiagnosticsMenuItem"
                          AutomationProperties.AutomationId="NativeDllDiagnosticsMenuItem"
                          Header="Native DLL _Diagnostics"
                          Command="{Binding ShowNativeDiagnosticsCommand}" />
                <MenuItem x:Name="OpenRuntimeLogsMenuItem"
                          AutomationProperties.AutomationId="OpenRuntimeLogsMenuItem"
                          Header="Open Runtime _Logs (Phase 1a+)"
                          IsEnabled="False"
                          ToolTip="Enabled when persistent runtime log export is available." />
                <MenuItem x:Name="PInvokeSmokeTestMenuItem"
                          AutomationProperties.AutomationId="PInvokeSmokeTestMenuItem"
                          Header="Run P/_Invoke Smoke Test (SPRINT-P0-07)"
                          IsEnabled="False"
                          ToolTip="Requires xpe_common.dll and RealXpeBackend integration." />
            </MenuItem>

            <MenuItem x:Name="ViewMenu"
                      AutomationProperties.AutomationId="ViewMenu"
                      Header="_View">
                <MenuItem x:Name="ShowRuntimePanelMenuItem"
                          AutomationProperties.AutomationId="ShowRuntimePanelMenuItem"
                          Header="Runtime Panel"
                          IsCheckable="True"
                          IsChecked="{Binding ShowRuntimePanel, Mode=TwoWay}" />
                <MenuItem x:Name="ShowRawSettingsPanelMenuItem"
                          AutomationProperties.AutomationId="ShowRawSettingsPanelMenuItem"
                          Header="Raw Settings Panel"
                          IsCheckable="True"
                          IsChecked="{Binding ShowRawSettingsPanel, Mode=TwoWay}" />
                <MenuItem x:Name="ShowCalibrationPanelMenuItem"
                          AutomationProperties.AutomationId="ShowCalibrationPanelMenuItem"
                          Header="Calibration Paths Panel"
                          IsCheckable="True"
                          IsChecked="{Binding ShowCalibrationPanel, Mode=TwoWay}" />
                <MenuItem x:Name="ShowDisplaySettingsPanelMenuItem"
                          AutomationProperties.AutomationId="ShowDisplaySettingsPanelMenuItem"
                          Header="Display Settings Panel"
                          IsCheckable="True"
                          IsChecked="{Binding Settings.ShowDisplayPanel, Mode=TwoWay}" />
                <MenuItem x:Name="ShowImageSummaryPanelMenuItem"
                          AutomationProperties.AutomationId="ShowImageSummaryPanelMenuItem"
                          Header="Image Summary Panel"
                          IsCheckable="True"
                          IsChecked="{Binding ShowImageSummaryPanel, Mode=TwoWay}" />
                <MenuItem x:Name="ShowMetadataPanelMenuItem"
                          AutomationProperties.AutomationId="ShowMetadataPanelMenuItem"
                          Header="Metadata / Notes Panel"
                          IsCheckable="True"
                          IsChecked="{Binding ShowMetadataPanel, Mode=TwoWay}" />
                <MenuItem x:Name="ShowLogsPanelMenuItem"
                          AutomationProperties.AutomationId="ShowLogsPanelMenuItem"
                          Header="Logs Panel"
                          IsCheckable="True"
                          IsChecked="{Binding ShowLogsPanel, Mode=TwoWay}" />
                <MenuItem x:Name="ShowAlertsPanelMenuItem"
                          AutomationProperties.AutomationId="ShowAlertsPanelMenuItem"
                          Header="Alerts Panel"
                          IsCheckable="True"
                          IsChecked="{Binding ShowAlertsPanel, Mode=TwoWay}" />
                <Separator />
                <MenuItem x:Name="ClearLogsMenuItem"
                          AutomationProperties.AutomationId="ClearLogsMenuItem"
                          Header="Clear _Logs"
                          Command="{Binding ClearLogsCommand}" />
                <MenuItem x:Name="ClearAlertsMenuItem"
                          AutomationProperties.AutomationId="ClearAlertsMenuItem"
                          Header="Clear _Alerts"
                          Command="{Binding ClearAlertsCommand}" />
                <Separator />
                <MenuItem x:Name="ResetLayoutMenuItem"
                          AutomationProperties.AutomationId="ResetLayoutMenuItem"
                          Header="_Reset Layout"
                          Command="{Binding ResetLayoutCommand}" />
                <Separator />
                <MenuItem x:Name="ZoomFitMenuItem"
                          AutomationProperties.AutomationId="ZoomFitMenuItem"
                          Header="Zoom _Fit"
                          Command="{Binding ZoomFitCommand}" />
                <MenuItem x:Name="ZoomActualMenuItem"
                          AutomationProperties.AutomationId="ZoomActualMenuItem"
                          Header="Zoom _100%"
                          Command="{Binding ZoomActualCommand}" />
                <MenuItem x:Name="ZoomInMenuItem"
                          AutomationProperties.AutomationId="ZoomInMenuItem"
                          Header="Zoom _In"
                          Command="{Binding ZoomInCommand}" />
                <MenuItem x:Name="ZoomOutMenuItem"
                          AutomationProperties.AutomationId="ZoomOutMenuItem"
                          Header="Zoom _Out"
                          Command="{Binding ZoomOutCommand}" />
                <MenuItem x:Name="ResetComparisonViewMenuItem"
                          AutomationProperties.AutomationId="ResetComparisonViewMenuItem"
                          Header="Reset Comparison _View"
                          Command="{Binding ResetComparisonViewCommand}" />
                <MenuItem x:Name="DetachComparisonViewerMenuItem"
                          AutomationProperties.AutomationId="DetachComparisonViewerMenuItem"
                          Header="_Detach Comparison Viewer"
                          Command="{Binding DetachComparisonViewerCommand}" />
            </MenuItem>

            <MenuItem x:Name="PipelineMenu"
                      AutomationProperties.AutomationId="PipelineMenu"
                      Header="_Pipeline">
                <MenuItem x:Name="ApplyDisplayPipelineMenuItem"
                          AutomationProperties.AutomationId="ApplyDisplayPipelineMenuItem"
                          Header="Apply _Display Pipeline"
                          Command="{Binding ApplyDisplayPipelineCommand}" />
                <Separator />
                <MenuItem x:Name="RunPreprocessingMenuItem"
                          AutomationProperties.AutomationId="RunPreprocessingMenuItem"
                          Header="Run _Preprocessing (Phase 1a)"
                          IsEnabled="False"
                          ToolTip="Requires xpe_preprocess.dll." />
                <MenuItem x:Name="RunDeterministicBaselineMenuItem"
                          AutomationProperties.AutomationId="RunDeterministicBaselineMenuItem"
                          Header="Run _Deterministic Baseline (Phase 1b)"
                          IsEnabled="False"
                          ToolTip="Requires preprocess, enhance_basic, display, and dicom modules." />
                <MenuItem x:Name="RunFullPipelineMenuItem"
                          AutomationProperties.AutomationId="RunFullPipelineMenuItem"
                          Header="Run _Full Pipeline (Phase 2/3)"
                          IsEnabled="False"
                          ToolTip="Requires optional premium and assistive modules." />
                <MenuItem x:Name="StopProcessingMenuItem"
                          AutomationProperties.AutomationId="StopProcessingMenuItem"
                          Header="_Stop Processing"
                          IsEnabled="False"
                          ToolTip="Enabled after a real processing run command exists." />
                <Separator />
                <MenuItem x:Name="StageTimingMenuItem"
                          AutomationProperties.AutomationId="StageTimingMenuItem"
                          Header="Stage _Timing"
                          IsEnabled="False"
                          ToolTip="Enabled when real pipeline timing evidence is available." />
                <MenuItem x:Name="OpenPipelineDiagnosticsMenuItem"
                          AutomationProperties.AutomationId="OpenPipelineDiagnosticsMenuItem"
                          Header="Open Pipeline _Diagnostics (Phase 1a+)"
                          IsEnabled="False"
                          ToolTip="Enabled when pipeline execution traces and timing diagnostics exist." />
            </MenuItem>

            <MenuItem x:Name="ToolsMenu"
                      AutomationProperties.AutomationId="ToolsMenu"
                      Header="_Tools">
                <MenuItem x:Name="CalibrationSettingsMenuItem"
                          AutomationProperties.AutomationId="CalibrationSettingsMenuItem"
                          Header="_Calibration Settings"
                          Command="{Binding ShowCalibrationSettingsCommand}" />
                <MenuItem x:Name="FixtureManagerMenuItem"
                          AutomationProperties.AutomationId="FixtureManagerMenuItem"
                          Header="_Fixture Manager"
                          Command="{Binding ShowFixtureManagerCommand}" />
                <MenuItem x:Name="ExportEvidenceSnapshotMenuItem"
                          AutomationProperties.AutomationId="ExportEvidenceSnapshotMenuItem"
                          Header="Export _Evidence Snapshot"
                          Command="{Binding ExportAutomationReportCommand}" />
                <MenuItem x:Name="OpenEvidenceFolderMenuItem"
                          AutomationProperties.AutomationId="OpenEvidenceFolderMenuItem"
                          Header="Open Evidence _Folder (Phase 1a+)"
                          IsEnabled="False"
                          ToolTip="Enabled when the evidence artifact directory is managed by the app." />
                <Separator />
                <MenuItem x:Name="RunSelfCheckMenuItem"
                          AutomationProperties.AutomationId="RunSelfCheckMenuItem"
                          Header="Run _Self-Check"
                          IsEnabled="False"
                          ToolTip="Available through the current test runner; in-app launch is a later tools command." />
                <MenuItem x:Name="RunGuiE2EMenuItem"
                          AutomationProperties.AutomationId="RunGuiE2EMenuItem"
                          Header="Run GUI _E2E"
                          IsEnabled="False"
                          ToolTip="Available through the current test runner; in-app launch is a later tools command." />
                <MenuItem x:Name="BenchmarkRunnerMenuItem"
                          AutomationProperties.AutomationId="BenchmarkRunnerMenuItem"
                          Header="_Benchmark Runner (Phase 1a+)"
                          IsEnabled="False"
                          ToolTip="Requires benchmark manifests and native module execution." />
                <MenuItem x:Name="QaConstancyMenuItem"
                          AutomationProperties.AutomationId="QaConstancyMenuItem"
                          Header="_QA Constancy (Phase 1b+)"
                          IsEnabled="False"
                          ToolTip="Requires QA workflow implementation." />
                <MenuItem x:Name="GsdfCalibrateMenuItem"
                          AutomationProperties.AutomationId="GsdfCalibrateMenuItem"
                          Header="_GSDF Calibrate... (Phase 1b+)"
                          IsEnabled="False"
                          ToolTip="Enabled when validated DICOM PS3.14 luminance calibration workflow exists." />
            </MenuItem>

            <MenuItem x:Name="HelpMenu"
                      AutomationProperties.AutomationId="HelpMenu"
                      Header="_Help">
                <MenuItem x:Name="OpenHelpIndexMenuItem"
                          AutomationProperties.AutomationId="OpenHelpIndexMenuItem"
                          Header="_Help Home"
                          Click="OpenHelpIndexMenuItem_OnClick" />
                <MenuItem x:Name="OpenQuickStartHelpMenuItem"
                          AutomationProperties.AutomationId="OpenQuickStartHelpMenuItem"
                          Header="_Quick Start"
                          Click="OpenQuickStartHelpMenuItem_OnClick" />
                <MenuItem x:Name="OpenScopeHelpMenuItem"
                          AutomationProperties.AutomationId="OpenScopeHelpMenuItem"
                          Header="_Scope and Limitations"
                          Click="OpenScopeHelpMenuItem_OnClick" />
                <MenuItem x:Name="OpenCurrentWorkflowHelpMenuItem"
                          AutomationProperties.AutomationId="OpenCurrentWorkflowHelpMenuItem"
                          Header="_Current Workflow Help"
                          ToolTip="Opens help for the current GUI-S0 workflow."
                          Click="OpenCurrentWorkflowHelpMenuItem_OnClick" />
                <Separator />
                <MenuItem x:Name="OpenApiReferenceMenuItem"
                          AutomationProperties.AutomationId="OpenApiReferenceMenuItem"
                          Header="_API Reference (DocFX/Doxygen)"
                          IsEnabled="False"
                          ToolTip="Enabled when generated API reference is packaged." />
                <MenuItem x:Name="OpenTroubleshootingMenuItem"
                          AutomationProperties.AutomationId="OpenTroubleshootingMenuItem"
                          Header="_Troubleshooting (Phase 1b)"
                          IsEnabled="False"
                          ToolTip="Enabled when deterministic baseline troubleshooting pages are packaged." />
                <Separator />
                <MenuItem x:Name="AboutBuildInfoMenuItem"
                          AutomationProperties.AutomationId="AboutBuildInfoMenuItem"
                          Header="_About / Build Info"
                          Click="AboutBuildInfoMenuItem_OnClick" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem AutomationProperties.AutomationId="StatusBarText"
                           Content="{Binding StatusText}" />
        </StatusBar>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button x:Name="InitializeBackendButton"
                        AutomationProperties.AutomationId="InitializeBackendButton"
                        Command="{Binding InitializeBackendCommand}"
                        Content="Initialize Backend" />
                <Button x:Name="ShutdownBackendButton"
                        AutomationProperties.AutomationId="ShutdownBackendButton"
                        Command="{Binding ShutdownBackendCommand}"
                        Content="Shutdown Backend" />
                <Separator />
                <Button x:Name="LoadRawImageButton"
                        AutomationProperties.AutomationId="LoadRawImageButton"
                        Command="{Binding LoadImageCommand}"
                        Content="Load Raw Image" />
                <Button x:Name="SaveSettingsButton"
                        AutomationProperties.AutomationId="SaveSettingsButton"
                        Command="{Binding SaveSettingsCommand}"
                        Content="Save Settings" />
                <Separator />
                <Button x:Name="ClearLogsButton"
                        AutomationProperties.AutomationId="ClearLogsButton"
                        Command="{Binding ClearLogsCommand}"
                        Content="Clear Logs" />
                <Button x:Name="ClearAlertsButton"
                        AutomationProperties.AutomationId="ClearAlertsButton"
                        Command="{Binding ClearAlertsCommand}"
                        Content="Clear Alerts" />
            </ToolBar>
        </ToolBarTray>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="320" />
                <ColumnDefinition Width="*" MinWidth="520" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="480" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                <StackPanel>
                    <GroupBox x:Name="RuntimeGroup"
                              AutomationProperties.AutomationId="RuntimeGroup"
                              Header="Runtime"
                              Margin="0,0,0,12"
                              Visibility="{Binding ShowRuntimePanel, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Margin="10">
                            <TextBlock FontWeight="Bold" Text="Requested Backend Mode" />
                            <ComboBox x:Name="BackendModeComboBox"
                                      AutomationProperties.AutomationId="BackendModeComboBox"
                                      ItemsSource="{Binding BackendModeOptions}"
                                      SelectedItem="{Binding Settings.BackendMode, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,4,0,8" />

                            <TextBlock FontWeight="Bold" Text="Backend Name" />
                            <TextBlock Margin="0,4,0,8" Text="{Binding RuntimeInfo.BackendName}" />

                            <TextBlock FontWeight="Bold" Text="Version" />
                            <TextBlock x:Name="BackendVersionText"
                                       AutomationProperties.AutomationId="BackendVersionText"
                                       Margin="0,4,0,8"
                                       Text="{Binding RuntimeInfo.Version}" />

                            <TextBlock FontWeight="Bold" Text="State" />
                            <TextBlock Margin="0,4,0,8" Text="{Binding RuntimeInfo.State}" />

                            <TextBlock FontWeight="Bold" Text="Supports Native Runtime" />
                            <TextBlock Margin="0,4,0,8" Text="{Binding RuntimeInfo.SupportsNativeRuntime}" />

                            <TextBlock FontWeight="Bold" Text="Native DLL Detected" />
                            <TextBlock Margin="0,4,0,8" Text="{Binding RuntimeInfo.NativeDllDetected}" />

                            <TextBlock FontWeight="Bold" Text="Native DLL Path" />
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding RuntimeInfo.NativeDllPath}" />

                            <TextBlock FontWeight="Bold" Margin="0,8,0,0" Text="Display Version" />
                            <TextBlock x:Name="DisplayVersionText"
                                       AutomationProperties.AutomationId="DisplayVersionText"
                                       Margin="0,4,0,8"
                                       Text="{Binding RuntimeInfo.DisplayVersion}" />

                            <TextBlock FontWeight="Bold" Text="Display DLL Detected" />
                            <TextBlock Margin="0,4,0,8" Text="{Binding RuntimeInfo.DisplayDllDetected}" />

                            <TextBlock FontWeight="Bold" Text="Display DLL Path" />
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding RuntimeInfo.DisplayDllPath}" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Name="RawImageSettingsGroup"
                              AutomationProperties.AutomationId="RawImageSettingsGroup"
                              Header="Raw Image Settings"
                              Margin="0,0,0,12"
                              Visibility="{Binding ShowRawSettingsPanel, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Margin="10">
                            <TextBlock FontWeight="Bold" Text="Raw Width" />
                            <TextBox Margin="0,4,0,8" Text="{Binding Settings.RawWidth, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock FontWeight="Bold" Text="Raw Height" />
                            <TextBox Margin="0,4,0,8" Text="{Binding Settings.RawHeight, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock FontWeight="Bold" Text="Raw Pixel Format" />
                            <TextBox Margin="0,4,0,8" Text="{Binding Settings.RawPixelFormat, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock FontWeight="Bold" Text="Last Raw Directory" />
                            <TextBox Margin="0,4,0,0" Text="{Binding Settings.LastRawDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Name="CalibrationPathsGroup"
                              AutomationProperties.AutomationId="CalibrationPathsGroup"
                              Header="Calibration Evaluation"
                              Margin="0,0,0,12"
                              Visibility="{Binding ShowCalibrationPanel, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Margin="10">
                            <TextBlock FontWeight="Bold" Text="Fixture / Calibration Paths" />
                            <TextBlock Margin="0,2,0,8"
                                       Foreground="#475569"
                                       TextWrapping="Wrap"
                                       Text="Test GUI evaluation records the selected Off/On/Auto stage mix. Product-mode mandatory policy is validated separately by xpe_preprocess.dll." />

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="88" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Row="0" Grid.Column="0" Margin="0,0,8,8"
                                         AutomationProperties.AutomationId="OffsetCalibrationPathTextBox"
                                         Text="{Binding Settings.OffsetCalibrationDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                                        AutomationProperties.AutomationId="BrowseOffsetCalibrationDirectoryButton"
                                        Command="{Binding BrowseOffsetCalibrationDirectoryCommand}"
                                        Content="Browse" />

                                <TextBox Grid.Row="1" Grid.Column="0" Margin="0,0,8,8"
                                         AutomationProperties.AutomationId="GainCalibrationPathTextBox"
                                         Text="{Binding Settings.GainCalibrationDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                                        AutomationProperties.AutomationId="BrowseGainCalibrationDirectoryButton"
                                        Command="{Binding BrowseGainCalibrationDirectoryCommand}"
                                        Content="Browse" />

                                <TextBox Grid.Row="2" Grid.Column="0"
                                         AutomationProperties.AutomationId="DefectCalibrationPathTextBox"
                                         Text="{Binding Settings.DefectCalibrationDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Row="2" Grid.Column="1"
                                        AutomationProperties.AutomationId="BrowseDefectCalibrationDirectoryButton"
                                        Command="{Binding BrowseDefectCalibrationDirectoryCommand}"
                                        Content="Browse" />
                            </Grid>

                            <Separator Margin="0,10,0,10" />

                            <TextBlock FontWeight="Bold" Text="Stage Modes" />
                            <TextBlock Margin="0,2,0,8"
                                       Foreground="#475569"
                                       TextWrapping="Wrap"
                                       Text="Auto follows fixture/native metadata, On forces a stage for A/B evaluation, and Off bypasses it for effect measurement." />

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="115" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Offset" />
                                <UniformGrid Grid.Row="0" Grid.Column="1" Columns="3" Margin="0,0,0,8">
                                    <RadioButton x:Name="OffsetModeAutoRadioButton" AutomationProperties.AutomationId="OffsetModeAutoRadioButton" Content="Auto" GroupName="OffsetCorrectionMode" IsChecked="{Binding Settings.OffsetCorrectionMode, Mode=TwoWay, Converter={StaticResource StringEquals}, ConverterParameter=Auto}" />
                                    <RadioButton x:Name="OffsetModeOnRadioButton" AutomationProperties.AutomationId="OffsetModeOnRadioButton" Content="On" GroupName="OffsetCorrectionMode" IsChecked="{Binding Settings.OffsetCorrectionMode, Mode=TwoWay, Converter={StaticResource StringEquals}, ConverterParameter=On}" />
                                    <RadioButton x:Name="OffsetModeOffRadioButton" AutomationProperties.AutomationId="OffsetModeOffRadioButton" Content="Off" GroupName="OffsetCorrectionMode" IsChecked="{Binding Settings.OffsetCorrectionMode, Mode=TwoWay, Converter={StaticResource StringEquals}, ConverterParameter=Off}" />
                                </UniformGrid>

                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Gain" />
                                <UniformGrid Grid.Row="1" Grid.Column="1" Columns="3" Margin="0,0,0,8">
                                    <RadioButton x:Name="GainModeAutoRadioButton" AutomationProperties.AutomationId="GainModeAutoRadioButton" Content="Auto" GroupName="GainCorrectionMode" IsChecked="{Binding Settings.GainCorrectionMode, Mode=TwoWay, Converter={StaticResource StringEquals}, ConverterParameter=Auto}" />
                                    <RadioButton x:Name="GainModeOnRadioButton" AutomationProperties.AutomationId="GainModeOnRadioButton" Content="On" GroupName="GainCorrectionMode" IsChecked="{Binding Settings.GainCorrectionMode, Mode=TwoWay, Converter={StaticResource StringEquals}, ConverterParameter=On}" />
                                    <RadioButton x:Name="GainModeOffRadioButton" AutomationProperties.AutomationId="GainModeOffRadioButton" Content="Off" GroupName="GainCorrectionMode" IsChecked="{Binding Settings.GainCorrectionMode, Mode=TwoWay, Converter={StaticResource StringEquals}, ConverterParameter=Off}" />
                                </UniformGrid>

                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Defect" />
                                <UniformGrid Grid.Row="2" Grid.Column="1" Columns="3" Margin="0,0,0,8">
                                    <RadioButton x:Name="DefectModeAutoRadioButton" AutomationProperties.AutomationId="DefectModeAutoRadioButton" Content="Auto" GroupName="DefectCorrectionMode" IsChecked="{Binding Settings.DefectCorrectionMode, Mode=TwoWay, Converter={StaticResource StringEquals}, ConverterParameter=Auto}" />
                                    <RadioButton x:Name="DefectModeOnRadioButton" AutomationProperties.AutomationId="DefectModeOnRadioButton" Content="On" GroupName="DefectCorrectionMode" IsChecked="{Binding Settings.DefectCorrectionMode, Mode=TwoWay, Converter={StaticResource StringEquals}, ConverterParameter=On}" />
                                    <RadioButton x:Name="DefectModeOffRadioButton" AutomationProperties.AutomationId="DefectModeOffRadioButton" Content="Off" GroupName="DefectCorrectionMode" IsChecked="{Binding Settings.DefectCorrectionMode, Mode=TwoWay, Converter={StaticResource StringEquals}, ConverterParameter=Off}" />
                                </UniformGrid>

                                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Ghost/Lag" />
                                <UniformGrid Grid.Row="3" Grid.Column="1" Columns="3" Margin="0,0,0,8">
                                    <RadioButton x:Name="GhostModeAutoRadioButton" AutomationProperties.AutomationId="GhostModeAutoRadioButton" Content="Auto" GroupName="GhostCorrectionMode" IsChecked="{Binding Settings.GhostCorrectionMode, Mode=TwoWay, Converter={StaticResource StringEquals}, ConverterParameter=Auto}" />
                                    <RadioButton x:Name="GhostModeOnRadioButton" AutomationProperties.AutomationId="GhostModeOnRadioButton" Content="On" GroupName="GhostCorrectionMode" IsChecked="{Binding Settings.GhostCorrectionMode, Mode=TwoWay, Converter={StaticResource StringEquals}, ConverterParameter=On}" />
                                    <RadioButton x:Name="GhostModeOffRadioButton" AutomationProperties.AutomationId="GhostModeOffRadioButton" Content="Off" GroupName="GhostCorrectionMode" IsChecked="{Binding Settings.GhostCorrectionMode, Mode=TwoWay, Converter={StaticResource StringEquals}, ConverterParameter=Off}" />
                                </UniformGrid>

                                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Temperature" />
                                <UniformGrid Grid.Row="4" Grid.Column="1" Columns="3" Margin="0,0,0,8">
                                    <RadioButton x:Name="TemperatureModeAutoRadioButton" AutomationProperties.AutomationId="TemperatureModeAutoRadioButton" Content="Auto" GroupName="TemperatureCompensationMode" IsChecked="{Binding Settings.TemperatureCompensationMode, Mode=TwoWay, Converter={StaticResource StringEquals}, ConverterParameter=Auto}" />
                                    <RadioButton x:Name="TemperatureModeOnRadioButton" AutomationProperties.AutomationId="TemperatureModeOnRadioButton" Content="On" GroupName="TemperatureCompensationMode" IsChecked="{Binding Settings.TemperatureCompensationMode, Mode=TwoWay, Converter={StaticResource StringEquals}, ConverterParameter=On}" />
                                    <RadioButton x:Name="TemperatureModeOffRadioButton" AutomationProperties.AutomationId="TemperatureModeOffRadioButton" Content="Off" GroupName="TemperatureCompensationMode" IsChecked="{Binding Settings.TemperatureCompensationMode, Mode=TwoWay, Converter={StaticResource StringEquals}, ConverterParameter=Off}" />
                                </UniformGrid>

                                <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Nonlinearity" />
                                <UniformGrid Grid.Row="5" Grid.Column="1" Columns="3" Margin="0,0,0,8">
                                    <RadioButton x:Name="NonlinearityModeAutoRadioButton" AutomationProperties.AutomationId="NonlinearityModeAutoRadioButton" Content="Auto" GroupName="NonlinearityCorrectionMode" IsChecked="{Binding Settings.NonlinearityCorrectionMode, Mode=TwoWay, Converter={StaticResource StringEquals}, ConverterParameter=Auto}" />
                                    <RadioButton x:Name="NonlinearityModeOnRadioButton" AutomationProperties.AutomationId="NonlinearityModeOnRadioButton" Content="On" GroupName="NonlinearityCorrectionMode" IsChecked="{Binding Settings.NonlinearityCorrectionMode, Mode=TwoWay, Converter={StaticResource StringEquals}, ConverterParameter=On}" />
                                    <RadioButton x:Name="NonlinearityModeOffRadioButton" AutomationProperties.AutomationId="NonlinearityModeOffRadioButton" Content="Off" GroupName="NonlinearityCorrectionMode" IsChecked="{Binding Settings.NonlinearityCorrectionMode, Mode=TwoWay, Converter={StaticResource StringEquals}, ConverterParameter=Off}" />
                                </UniformGrid>

                                <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="Binning" />
                                <UniformGrid Grid.Row="6" Grid.Column="1" Columns="3">
                                    <RadioButton x:Name="BinningModeAutoRadioButton" AutomationProperties.AutomationId="BinningModeAutoRadioButton" Content="Auto" GroupName="BinningCorrectionMode" IsChecked="{Binding Settings.BinningCorrectionMode, Mode=TwoWay, Converter={StaticResource StringEquals}, ConverterParameter=Auto}" />
                                    <RadioButton x:Name="BinningModeOnRadioButton" AutomationProperties.AutomationId="BinningModeOnRadioButton" Content="On" GroupName="BinningCorrectionMode" IsChecked="{Binding Settings.BinningCorrectionMode, Mode=TwoWay, Converter={StaticResource StringEquals}, ConverterParameter=On}" />
                                    <RadioButton x:Name="BinningModeOffRadioButton" AutomationProperties.AutomationId="BinningModeOffRadioButton" Content="Off" GroupName="BinningCorrectionMode" IsChecked="{Binding Settings.BinningCorrectionMode, Mode=TwoWay, Converter={StaticResource StringEquals}, ConverterParameter=Off}" />
                                </UniformGrid>
                            </Grid>

                            <TextBlock x:Name="CalibrationEvaluationSummaryText"
                                       AutomationProperties.AutomationId="CalibrationEvaluationSummaryText"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Text="{Binding CalibrationEvaluationSummary}" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Name="DisplaySettingsGroup"
                              AutomationProperties.AutomationId="DisplaySettingsGroup"
                              Header="Display Settings"
                              Margin="0,0,0,12"
                              Visibility="{Binding Settings.ShowDisplayPanel, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Margin="10">
                            <TextBlock FontWeight="Bold" Text="VOI Mode" />
                            <ComboBox x:Name="VoiLutModeComboBox"
                                      AutomationProperties.AutomationId="VoiLutModeComboBox"
                                      ItemsSource="{Binding VoiLutModeOptions}"
                                      SelectedItem="{Binding Settings.VoiLutMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,4,0,8" />

                            <TextBlock FontWeight="Bold" Text="Window Center" />
                            <TextBox x:Name="VoiWindowCenterTextBox"
                                     AutomationProperties.AutomationId="VoiWindowCenterTextBox"
                                     Margin="0,4,0,8"
                                     Text="{Binding Settings.VoiWindowCenter, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock FontWeight="Bold" Text="Window Width" />
                            <TextBox x:Name="VoiWindowWidthTextBox"
                                     AutomationProperties.AutomationId="VoiWindowWidthTextBox"
                                     Margin="0,4,0,8"
                                     Text="{Binding Settings.VoiWindowWidth, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock FontWeight="Bold" Text="Body Part Preset" />
                            <ComboBox x:Name="BodyPartPresetComboBox"
                                      AutomationProperties.AutomationId="BodyPartPresetComboBox"
                                      ItemsSource="{Binding BodyPartOptions}"
                                      SelectedItem="{Binding Settings.SelectedBodyPart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,4,0,8" />

                            <Button x:Name="ApplyBodyPartPresetButton"
                                    AutomationProperties.AutomationId="ApplyBodyPartPresetButton"
                                    Command="{Binding ApplyBodyPartPresetCommand}"
                                    Content="Apply Body Part Preset"
                                    Margin="0,0,0,8" />

                            <CheckBox x:Name="GsdfEnabledCheckBox"
                                      AutomationProperties.AutomationId="GsdfEnabledCheckBox"
                                      Content="GSDF Enabled (validation pending)"
                                      IsChecked="{Binding Settings.GsdfEnabled, Mode=TwoWay}"
                                      Margin="0,0,0,8" />

                            <TextBlock FontWeight="Bold" Text="Modality Rescale Slope" />
                            <TextBox x:Name="ModalityRescaleSlopeTextBox"
                                     AutomationProperties.AutomationId="ModalityRescaleSlopeTextBox"
                                     Margin="0,4,0,8"
                                     Text="{Binding Settings.ModalityRescaleSlope, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock FontWeight="Bold" Text="Modality Rescale Intercept" />
                            <TextBox x:Name="ModalityRescaleInterceptTextBox"
                                     AutomationProperties.AutomationId="ModalityRescaleInterceptTextBox"
                                     Margin="0,4,0,8"
                                     Text="{Binding Settings.ModalityRescaleIntercept, UpdateSourceTrigger=PropertyChanged}" />

                            <Button x:Name="ApplyDisplayPipelineButton"
                                    AutomationProperties.AutomationId="ApplyDisplayPipelineButton"
                                    Command="{Binding ApplyDisplayPipelineCommand}"
                                    Content="Apply Display Pipeline"
                                    Margin="0,0,0,8" />

                            <TextBlock x:Name="DisplayPipelineSummaryText"
                                       AutomationProperties.AutomationId="DisplayPipelineSummaryText"
                                       TextWrapping="Wrap"
                                       Text="{Binding DisplayPipelineSummary}" />

                            <Separator Margin="0,10,0,10" />

                            <TextBlock FontWeight="Bold" Text="Comparison Mode" />
                            <ComboBox x:Name="ComparisonModeComboBox"
                                      AutomationProperties.AutomationId="ComparisonModeComboBox"
                                      ItemsSource="{Binding CompareModeOptions}"
                                      SelectedItem="{Binding Settings.ComparisonMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,4,0,8" />

                            <TextBlock FontWeight="Bold" Text="Overlay Opacity" />
                            <Slider x:Name="ComparisonOverlayOpacitySlider"
                                    AutomationProperties.AutomationId="ComparisonOverlayOpacitySlider"
                                    Minimum="0"
                                    Maximum="1"
                                    TickFrequency="0.1"
                                    IsSnapToTickEnabled="False"
                                    Value="{Binding Settings.ComparisonOverlayOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="0,4,0,8" />

                            <UniformGrid Columns="2" Margin="0,0,0,8">
                                <Button x:Name="ZoomFitButton"
                                        AutomationProperties.AutomationId="ZoomFitButton"
                                        Command="{Binding ZoomFitCommand}"
                                        Content="Fit"
                                        Margin="0,0,4,4" />
                                <Button x:Name="ZoomActualButton"
                                        AutomationProperties.AutomationId="ZoomActualButton"
                                        Command="{Binding ZoomActualCommand}"
                                        Content="100%"
                                        Margin="4,0,0,4" />
                                <Button x:Name="ZoomInButton"
                                        AutomationProperties.AutomationId="ZoomInButton"
                                        Command="{Binding ZoomInCommand}"
                                        Content="Zoom In"
                                        Margin="0,4,4,0" />
                                <Button x:Name="ZoomOutButton"
                                        AutomationProperties.AutomationId="ZoomOutButton"
                                        Command="{Binding ZoomOutCommand}"
                                        Content="Zoom Out"
                                        Margin="4,4,0,0" />
                            </UniformGrid>

                            <Button x:Name="DetachComparisonViewerButton"
                                    AutomationProperties.AutomationId="DetachComparisonViewerButton"
                                    Command="{Binding DetachComparisonViewerCommand}"
                                    Content="Detach Comparison Viewer"
                                    Margin="0,0,0,8" />

                            <TextBlock x:Name="ComparisonStatusText"
                                       AutomationProperties.AutomationId="ComparisonStatusText"
                                       TextWrapping="Wrap"
                                       Text="{Binding ComparisonStatus}" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Name="ImageSummaryGroup"
                              AutomationProperties.AutomationId="ImageSummaryGroup"
                              Header="Image Summary"
                              Visibility="{Binding ShowImageSummaryPanel, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock x:Name="ImageSummaryText"
                                   AutomationProperties.AutomationId="ImageSummaryText"
                                   Margin="10"
                                   TextWrapping="Wrap"
                                   Text="{Binding ActiveImageSummary}" />
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="180" />
                </Grid.RowDefinitions>

                <GroupBox x:Name="ComparisonViewportGroup"
                          AutomationProperties.AutomationId="ComparisonViewportGroup"
                          Header="Source vs Processed Comparison"
                          Margin="0,0,0,12">
                    <Border Margin="10" BorderBrush="#334155" BorderThickness="1" Background="#0F172A">
                        <controls:ImageComparisonViewport x:Name="ImageComparisonViewport"
                                                          AutomationProperties.AutomationId="ImageComparisonViewport"
                                                          SourceImage="{Binding SourceImage}"
                                                          ProcessedImage="{Binding ProcessedImage}"
                                                          CompareMode="{Binding Settings.ComparisonMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          ZoomScale="{Binding Settings.ComparisonZoomScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          PanX="{Binding Settings.ComparisonPanX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          PanY="{Binding Settings.ComparisonPanY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          SwipePosition="{Binding Settings.ComparisonSwipePosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          OverlayOpacity="{Binding Settings.ComparisonOverlayOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>
                </GroupBox>

                <GroupBox x:Name="MetadataNotesGroup"
                          AutomationProperties.AutomationId="MetadataNotesGroup"
                          Grid.Row="1"
                          Header="Metadata / Notes"
                          Visibility="{Binding ShowMetadataPanel, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer Margin="10" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="MetadataTextBlock"
                                   AutomationProperties.AutomationId="MetadataTextBlock"
                                   TextWrapping="Wrap"
                                   Text="{Binding MetadataText}" />
                    </ScrollViewer>
                </GroupBox>
            </Grid>

            <GridSplitter x:Name="DiagnosticsColumnSplitter"
                          Grid.Column="2"
                          AutomationProperties.AutomationId="DiagnosticsColumnSplitter"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#2D3748"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          ShowsPreview="True"
                          ToolTip="Drag to resize image preview and Logs/Alerts panels." />

            <Grid Grid.Column="3" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="140" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="*" MinHeight="140" />
                </Grid.RowDefinitions>

                <GroupBox x:Name="LogsGroup"
                          AutomationProperties.AutomationId="LogsGroup"
                          Header="Logs"
                          Margin="0,0,0,8"
                          Visibility="{Binding ShowLogsPanel, Converter={StaticResource BoolToVisibility}}">
                    <ListBox x:Name="LogsListBox"
                             AutomationProperties.AutomationId="LogsListBox"
                             Margin="10"
                             ItemsSource="{Binding Logs}"
                             FontFamily="Consolas"
                             FontSize="12" />
                </GroupBox>

                <GridSplitter x:Name="LogsAlertsSplitter"
                              Grid.Row="1"
                              AutomationProperties.AutomationId="LogsAlertsSplitter"
                              Height="6"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="#2D3748"
                              ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Rows"
                              ShowsPreview="True"
                              ToolTip="Drag to resize Logs and Alerts panels." />

                <GroupBox x:Name="AlertsGroup"
                          AutomationProperties.AutomationId="AlertsGroup"
                          Grid.Row="2"
                          Header="Alerts"
                          Visibility="{Binding ShowAlertsPanel, Converter={StaticResource BoolToVisibility}}">
                    <ListBox x:Name="AlertsListBox"
                             AutomationProperties.AutomationId="AlertsListBox"
                             Margin="10"
                             ItemsSource="{Binding Alerts}"
                             FontFamily="Consolas"
                             FontSize="12">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6" Margin="0,0,0,6" CornerRadius="4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#223040" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="INFO">
                                                    <Setter Property="Background" Value="#1F3344" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="WARN">
                                                    <Setter Property="Background" Value="#4D3A18" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="ERROR">
                                                    <Setter Property="Background" Value="#4A1F24" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Foreground="#F8FAFC"
                                               TextWrapping="Wrap"
                                               Text="{Binding}" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </GroupBox>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
