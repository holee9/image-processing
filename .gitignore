*.sln
*.suo
.#*

# ===========================================
# OS Files
# ===========================================
# Mac
.DS_Store
.AppleDouble
.LSOverride
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns

# Windows
[Dd]esktop.ini
Thumbs.db
ehthumbs.db

# Linux
.directory

# ===========================================
# Logs & Temporary Files
# ===========================================
*.log
logs/*
!logs/.gitkeep
*.tmp
*.temp
*.bak
*.backup

# ===========================================
# Backups
# ===========================================
.moai-backups/
.moai/backups/
*.backup/
*-backup/
*_backup_*/

# ===========================================
# Secrets and Credentials (CRITICAL)
# ===========================================
# Environment files
.env
.env.*
!.env.example

# Certificate files
*.pem
# QA-B-195: the AI model-signing TEST keys are committed on purpose. They are not secret and the product never
# trusts them (the production trust list is separate); only these two files are excepted from the rule above.
!modules/ai/tests/data/signing/test_key_1.pem
!modules/ai/tests/data/signing/test_key_2.pem
*.p12
*.pfx
*.jks

# Private keys (specific patterns to avoid false positives)
# FIXED: Issue #237 - Replaced overly broad *key* and *secret* patterns
*-key.*
*_key.*
*.key.*
*-secret-key.*
*-api-key.*
api-key-*
secret-key-*
private-key*
*-secret.*
*_secret.*
*.secret.*
secret-*.*

# Credential patterns in environment files
*_secret=*
*_token=*

# Cloud provider credentials
.aws/config
.aws/credentials

# MoAI git-credential runtime files (defense-in-depth). The reconfigure wizard
# delegates git provider credentials to the gh/glab CLI and never writes an
# access token to a tracked config; these patterns ensure that if a
# credential-bearing runtime file is ever introduced under .moai/, it is not
# committed.
.moai/**/credentials.yaml
.moai/**/*.credentials

# MINK agent credentials (plaintext API keys, per AC-CR-026).
# Ignored anywhere in the tree so per-project auth dirs are never committed.
**/.mink/auth/

# ===========================================
# Claude Code Configuration
# ===========================================
.claude/settings.local.json
.claude/settings.local.*.json
.claude/.env.local*
.claude/local/
.claude/plans/
.claude/agent-memory/
.claude/worktrees/

# Skill-specific credentials
.claude/skills/*/.env*
.claude/skills/*/secrets/
.claude/skills/*/*/*secret*
.claude/skills/*/*/*key*
.claude/skills/*/*/*token*
# Re-include legitimate skill module files containing "token" in their name
!.claude/skills/*/modules/*token*.md

# ===========================================
# Local-Only Files (never sync via git pull)
# ===========================================
.moai/status_line.sh
.moai/memory/
.moai/worktrees/
.moai/branches/

# ===========================================
# Update Noise-Suppression Ledgers (per-machine, never tracked)
# Per-machine state + cache ledgers used to suppress redundant update noise.
# ===========================================
.moai/state/
.moai/cache/

# ===========================================
# Plan Audit Reports (local artifacts)
# Plan-audit verdict reports are local artifacts; only .gitkeep is tracked.
# ===========================================
.moai/reports/plan-audit/*.md
!.moai/reports/plan-audit/.gitkeep

# ===========================================
# Evolution Telemetry (local-only usage data)
# Learnings and new-skills are git-tracked for team sharing.
# ===========================================
.moai/evolution/telemetry/*.jsonl
!.moai/evolution/telemetry/.gitkeep

# ===========================================
# Node.js (for docs/Nextra)
# ===========================================
node_modules/
*.tsbuildinfo
.tscache/
.next/
out/

# ===========================================
# Build Tools & Frameworks
# ===========================================
.turbo/
.nuxt/
dist-ssr/

# ===========================================
# Deployment & CI/CD
# ===========================================
.vercel/
.netlify/
.firebase/

# User Custom Patterns (preserved by moai update)
build_coverage/
artifacts/
build_standalone/
modules/**/build_standalone/
build_coverage/
.cache/
cmake-build-*/
build-debug/
build-parity/
buildsimd-parity/
build_test/
build_test2/
build_test3/
build_coverage/
lint_results.json
CMakeCache.txt
CMakeFiles/
*.obj
*.o
*.lib
*.ilk
*.exp
*.pdb
vcpkg_installed/
Testing/
# modules/*/tests/ was ignored here; removed 2026-09-09 (#118) — it hid new test files
# (72 tracked files stayed tracked, new ones needed `git add -f`).
modules/*/build/
gui/**/bin/
gui/**/obj/
clients/**/bin/
clients/**/obj/
clients/**/*.user
gui/**/*.user
!gui/**/*.sln
gui/**/artifacts/
gui/**/test_data/
.dotnet-cli/
test_results.json
*.trx
TestResults/
.mcp.json
.claude/scheduled_tasks.lock
data/models/*.onnx
tests/test_data/*.raw
tests/test_data/*.dcm
tests/test_data/**/*.raw
tests/test_data/**/*.dcm
tests/test_data/**/*.map
tests/test_data/**/*.pptx
tests/test_data/**/Cluster_position.txt
tests/test_data/**/PositionMap.raw
.moai/logs/

# 레인 증거는 추적한다 — 다만 서술만 (#163 에서 드러남)
#
# 리더의 판정은 `.moai/reports/lane-<lane>/<카드>/` 를 읽고 내리는데, 이 경로가
# 통째로 무시돼 있어 **인용한 증거가 이력에 남은 적이 없었다.** 게다가 보고서는
# 레인 워크트리에만 있고 워크트리는 폐기 대상이라, 워크트리를 지우면 근거가
# 사라진다. GUI-C-130 의 측정이 6일간 디스크에만 있었던 것이 그 실물이다.
#
# md/txt 만 담는다: 3레인 합쳐 815개 / 약 5MB, 100KB 초과 0건으로 측정됐다.
# 나머지(.log 1213 · .bin 166 · .dll 16 · .bat 463)는 덩치이거나 산출물이라
# 계속 무시한다. 큰 원문 출력은 md 안에 필요한 만큼만 인용한다.
.moai/reports/**
!.moai/reports/**/
!.moai/reports/lane-*/**/*.md
!.moai/reports/lane-*/**/*.txt

.moai/lanes/
.moai/plans/
_workspace/
build_collimation_test/
build_collimation_test2/
build_xpe.bat
do_build.bat
rebuild.bat
run_all_tests.bat
run_t301.bat
run_tests.bat
build-and-test.ps1
build-result.txt
.moai/docs/MCP_OAUTH_SETUP.md
*_build.bat
*_build.sh
*_build.ps1
*_build.cmd
*_output.txt
*_error.txt
build_*.txt
build_*.bat
build_*.sh
build_*.ps1
dev_*_*.txt
fullpath_*
nul

# ===========================================
# Tool output artifacts (repo hygiene, issue #96)
# ===========================================
lint_results.json
test_results.json
CLAUDE.local.md
