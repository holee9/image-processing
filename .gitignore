gui/**/obj/
clients/**/bin/
clients/**/obj/
clients/**/*.user
gui/**/*.user
!gui/**/*.sln
gui/**/artifacts/
gui/**/test_data/
.dotnet-cli/
test_results.json
*.trx
TestResults/
