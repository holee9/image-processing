<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0-windows, not net8.0: FlaUI drives Win32/UIA and the app under test is a WPF exe. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- GUI-C-46: the comparison viewport is a WPF FrameworkElement and this suite renders it
         directly to observe what DifferenceHeatmap actually draws (#149 G-4). -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned: a UIA binding that moves under us would change what the smoke suite measures. -->
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

  <!--
    UseWPF swaps the SDK's implicit-using set (System.Windows arrives, System.IO leaves), which
    silently broke every existing file that calls Path/File/Directory. Restored explicitly rather
    than adding a using line to each file: the implicit set is a project-level decision.
  -->
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <!--
    #200 (GUI-C-138): the P10 tile-mean signature travels INSIDE the assembly rather than being copied
    beside it. A copied file can go stale against the test that reads it (the copy is a separate build
    step that a partial build can skip); an embedded one cannot.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Fixtures\P10PreviewTileSignature.txt" />
  </ItemGroup>

  <!--
    Linked source, not a ProjectReference: referencing the WPF app would make this test assembly
    depend on ImageProcTest.exe, and a leftover app instance holding that exe already broke the
    build once (GUI-C-35, MSB3027). The repository uses the same linked-source pattern in
    ImageProcTest.IntegrationTests. Only the one control under observation is linked.
  -->
  <ItemGroup>
    <!-- #225 (GUI-C-166): the build-freshness guard is linked rather than copied. Two copies of the
         "which files are compile inputs" rule would drift, and that rule is the load-bearing part —
         its bin/obj exclusion and extension filter are both there for measured reasons. Linked, not
         referenced, for the same MSB3027 reason as everything else in this ItemGroup. -->
    <Compile Include="..\..\gui\ImageProcTest\Services\BuildFreshnessGuard.cs"
             Link="Fixtures\Linked\BuildFreshnessGuard.cs" />
    <Compile Include="..\..\gui\ImageProcTest\Controls\ImageComparisonViewport.cs"
             Link="Rendering\Linked\ImageComparisonViewport.cs" />
    <!-- #161: the control resolves the mode through this, so it comes along. Pure strings. -->
    <Compile Include="..\..\gui\ImageProcTest\Models\ComparisonModes.cs"
             Link="Rendering\Linked\ComparisonModes.cs" />
  </ItemGroup>

  <!--
    GUI-C-214 (#249): the legacy diagnostic app's native preprocess preview (NativePreprocessPreviewService) run end to end against the real xpe_preprocess.dll. It builds a WPF bitmap
    (that is why it lives in this net8.0-windows project and not in IntegrationTests) and is linked together with the small closure it needs. Linked source, not a reference to the
    app, for the same MSB3027 reason as above.
  -->
  <ItemGroup>
    <Compile Include="..\ImageProcTest\Services\NativePreprocessPreviewService.cs" Link="LegacyPreview\Linked\NativePreprocessPreviewService.cs" />
    <Compile Include="..\ImageProcTest\PInvokeWrapper.cs" Link="LegacyPreview\Linked\PInvokeWrapper.cs" />
    <Compile Include="..\ImageProcTest\Diagnostics\NativeDependencyLoader.cs" Link="LegacyPreview\Linked\NativeDependencyLoader.cs" />
    <Compile Include="..\ImageProcTest\Diagnostics\XpeCommonLibraryLocator.cs" Link="LegacyPreview\Linked\XpeCommonLibraryLocator.cs" />
    <Compile Include="..\ImageProcTest\Diagnostics\NativeSearchPolicy.cs" Link="LegacyPreview\Linked\NativeSearchPolicy.cs" />
    <Compile Include="..\ImageProcTest\Diagnostics\XpePreprocessLibraryLocator.cs" Link="LegacyPreview\Linked\XpePreprocessLibraryLocator.cs" />
    <Compile Include="..\ImageProcTest\Models\FixtureCaseInfo.cs" Link="LegacyPreview\Linked\FixtureCaseInfo.cs" />
    <Compile Include="..\ImageProcTest\Models\RawPreviewResult.cs" Link="LegacyPreview\Linked\RawPreviewResult.cs" />
    <Compile Include="..\ImageProcTest\Models\RawFileDescriptor.cs" Link="LegacyPreview\Linked\RawFileDescriptor.cs" />
    <Compile Include="..\ImageProcTest\Services\MetricsComputationService.cs" Link="LegacyPreview\Linked\MetricsComputationService.cs" />
    <Compile Include="..\ImageProcTest\Services\DefectMetricRows.cs" Link="LegacyPreview\Linked\DefectMetricRows.cs" />
    <Compile Include="..\ImageProcTest\Services\DefectMetricGates.cs" Link="LegacyPreview\Linked\DefectMetricGates.cs" />
    <Compile Include="..\ImageProcTest\Services\RawPreviewService.cs" Link="LegacyPreview\Linked\RawPreviewService.cs" />
    <Compile Include="..\ImageProcTest\DetectorDefaults.cs" Link="LegacyPreview\Linked\DetectorDefaults.cs" />
    <!-- GUI-C-212b: the synthetic oracle and its child-process host, to run the oracle against a calibration this test process holds. -->
    <Compile Include="..\ImageProcTest\Diagnostics\XpePreprocessSyntheticOracle.cs" Link="LegacyPreview\Linked\XpePreprocessSyntheticOracle.cs" />
    <Compile Include="..\ImageProcTest\Diagnostics\XpePreprocessOracleProcess.cs" Link="LegacyPreview\Linked\XpePreprocessOracleProcess.cs" />
    <Compile Include="..\ImageProcTest\Diagnostics\OracleThreadGuard.cs" Link="LegacyPreview\Linked\OracleThreadGuard.cs" />
    <Compile Include="..\ImageProcTest\Diagnostics\PreprocessSyntheticOracleResult.cs" Link="LegacyPreview\Linked\PreprocessSyntheticOracleResult.cs" />
  </ItemGroup>

</Project>
