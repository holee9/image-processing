<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- GUI-C-193: XPE_TEST_FAULTS (test fault switches) is defined for Debug only. -->
  <Import Project="..\..\gui\XpeTestFaults.props" />

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\expected-versions.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\requirement-matrix.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Linked source files for Phase 3 AI IPC Bridge UI logic (SPEC-XPE-P3-AI / Issue #83).
    These files have no WPF dependencies so they compile cleanly in this net8.0 test project.
    Tests live under AiBridgeUi/ and exercise the pure status-computer contract.
  -->
  <ItemGroup>
    <!-- #173 (GUI-C-115): the preset table and the old-name mapping are pinned by
         AlgorithmPresetTests. Linked rather than referenced, like everything else here. -->
    <Compile Include="..\..\gui\ImageProcTest\Models\AlgorithmPreset.cs" Link="Workbench\Linked\AlgorithmPreset.cs" />
    <Compile Include="..\ImageProcTest\Models\ModuleReadinessSnapshot.cs" Link="AiBridgeUi\Linked\ModuleReadinessSnapshot.cs" />
    <Compile Include="..\ImageProcTest\Models\AiBridgeConnectionStatus.cs" Link="AiBridgeUi\Linked\AiBridgeConnectionStatus.cs" />
    <Compile Include="..\ImageProcTest\Models\AiBridgePanelSnapshot.cs" Link="AiBridgeUi\Linked\AiBridgePanelSnapshot.cs" />
    <Compile Include="..\ImageProcTest\Services\AiBridgeStatusComputer.cs" Link="AiBridgeUi\Linked\AiBridgeStatusComputer.cs" />
    <!--
      #128: the native-module search used by the readiness probes. Linked (not referenced) because
      the app is a net8.0-windows WinExe this net8.0 project cannot reference, and because the file
      is free of WPF and of XpeCommonApi — linking anything that touches XpeCommonApi would register
      a second DllImport resolver on this assembly and throw (measured in GUI-C-13).
    -->
    <Compile Include="..\ImageProcTest\Diagnostics\NativeModuleLibraryLocator.cs" Link="DegradedMode\Linked\NativeModuleLibraryLocator.cs" />
    <Compile Include="..\ImageProcTest\Services\ModuleReadinessGrading.cs" Link="DegradedMode\Linked\ModuleReadinessGrading.cs" />
    <Compile Include="..\ImageProcTest\Diagnostics\NativeSearchPolicy.cs" Link="DegradedMode\Linked\NativeSearchPolicy.cs" />
    <!-- #129: the enhance_basic locator, now free of the wrapper const that used to drag XpeCommonApi in. -->
    <Compile Include="..\ImageProcTest\Diagnostics\XpeEnhanceBasicLibraryLocator.cs" Link="DegradedMode\Linked\XpeEnhanceBasicLibraryLocator.cs" />
    <Compile Include="..\ImageProcTest\Diagnostics\XpePreprocessLibraryLocator.cs" Link="DegradedMode\Linked\XpePreprocessLibraryLocator.cs" />
    <Compile Include="..\ImageProcTest\Diagnostics\XpeCommonLibraryLocator.cs" Link="DegradedMode\Linked\XpeCommonLibraryLocator.cs" />
    <!-- #110: alert-queue loss notice formatting (api-spec 5.17). Pure string logic, no native calls. -->
    <Compile Include="..\ImageProcTest\Services\AlertDisplayFormatter.cs" Link="Alerts\Linked\AlertDisplayFormatter.cs" />
    <!-- #110: the gui-side drain decision logic + the alert record it produces. Delegate-driven, no P/Invoke. -->
    <Compile Include="..\..\gui\ImageProcTest\Models\AlertEntry.cs" Link="Alerts\Linked\AlertEntry.cs" />
    <Compile Include="..\..\gui\ImageProcTest\Services\NativeAlertDrain.cs" Link="Alerts\Linked\NativeAlertDrain.cs" />
    <!--
      #161: the comparison-mode vocabulary and the settings object that stores it. Linked rather than
      referenced for the reason the block above gives, and free of WPF: AppSettings derives from
      ObservableObject (INotifyPropertyChanged only) and names CalibrationStageMode, so those two come
      along. Without them the single-source claim would be tested against a copy.
    -->
    <Compile Include="..\..\gui\ImageProcTest\Models\ComparisonModes.cs" Link="Comparison\Linked\ComparisonModes.cs" />
    <Compile Include="..\..\gui\ImageProcTest\Services\BuildIdentity.cs" Link="Comparison\Linked\BuildIdentity.cs" />
    <Compile Include="..\..\gui\ImageProcTest\Models\CalibrationStageMode.cs" Link="Comparison\Linked\CalibrationStageMode.cs" />
    <Compile Include="..\..\gui\ImageProcTest\Models\AppSettings.cs" Link="Comparison\Linked\AppSettings.cs" />
    <Compile Include="..\..\gui\ImageProcTest\ViewModels\ObservableObject.cs" Link="Comparison\Linked\ObservableObject.cs" />
    <!-- #161 (GUI-C-62): the loader itself, so the file path is exercised rather than described. Json + IO only. -->
    <Compile Include="..\..\gui\ImageProcTest\Services\AppSettingsService.cs" Link="Comparison\Linked\AppSettingsService.cs" />
    <!-- #136: automation command-line parsing. No WPF dependency, so the guard runs in CI. -->
    <Compile Include="..\..\gui\ImageProcTest\Services\AutomationArgs.cs" Link="Automation\Linked\AutomationArgs.cs" />
    <!-- #180 (GUI-C-99): the pixel chain model and runner are WPF-free and tested here. -->
    <!-- #225 row 20 (GUI-C-169): dependency-free by design, so it links without dragging services along. -->
    <Compile Include="..\..\gui\ImageProcTest\Services\ApiReferenceService.cs" Link="ApiReference\Linked\ApiReferenceService.cs" />
    <Compile Include="..\..\gui\ImageProcTest\Services\TroubleshootingPageService.cs" Link="TroubleshootingPage\Linked\TroubleshootingPageService.cs" />
    <!-- #225 row 10 (GUI-C-184): the AI stage's reading of the module's answer, native-call-free so the tests run it. -->
    <Compile Include="..\..\gui\ImageProcTest\Services\AiBoneSuppressionStage.cs" Link="AiBoneSuppression\Linked\AiBoneSuppressionStage.cs" />
    <Compile Include="..\..\gui\ImageProcTest\Services\AiBoneSuppressionAvailability.cs" Link="AiBoneSuppression\Linked\AiBoneSuppressionAvailability.cs" />
    <Compile Include="..\..\gui\ImageProcTest\Services\BackendLifecycle.cs" Link="AiBoneSuppression\Linked\BackendLifecycle.cs" />
    <Compile Include="..\..\gui\ImageProcTest\Services\BackendTelemetry.cs" Link="AiBoneSuppression\Linked\BackendTelemetry.cs" />
    <!-- #218 side finding (GUI-C-182): the defect metric pass lines, dependency-free, checked against the canonical protocol's text. -->
    <Compile Include="..\ImageProcTest\Services\DefectMetricGates.cs" Link="DefectMetricGates\Linked\DefectMetricGates.cs" />
    <Compile Include="..\ImageProcTest\Services\DefectMetricRows.cs" Link="DefectMetricGates\Linked\DefectMetricRows.cs" />
    <Compile Include="..\..\gui\ImageProcTest\Services\BenchmarkRunnerService.cs" Link="BenchmarkRunner\Linked\BenchmarkRunnerService.cs" />
    <Compile Include="..\..\gui\ImageProcTest\Services\RunnerProcess.cs" Link="BenchmarkRunner\Linked\RunnerProcess.cs" />
    <Compile Include="..\..\gui\ImageProcTest\Models\ProcessingChain.cs" Link="Chain\Linked\ProcessingChain.cs" />
    <Compile Include="..\..\gui\ImageProcTest\Services\ProcessingChainRunner.cs" Link="Chain\Linked\ProcessingChainRunner.cs" />
    <Compile Include="..\..\gui\ImageProcTest\Services\ProcessingChainPlan.cs" Link="Chain\Linked\ProcessingChainPlan.cs" />
    <Compile Include="..\..\gui\ImageProcTest\Services\BaselineDeterminism.cs" Link="Chain\Linked\BaselineDeterminism.cs" />
    <Compile Include="..\..\gui\ImageProcTest\Services\BaselineParameters.cs" Link="Chain\Linked\BaselineParameters.cs" />
    <Compile Include="..\..\gui\ImageProcTest\Services\BaselineRunner.cs" Link="Chain\Linked\BaselineRunner.cs" />
    <Compile Include="..\..\gui\ImageProcTest\Services\EnhanceBasicStage.cs" Link="Chain\Linked\EnhanceBasicStage.cs" />
    <Compile Include="..\..\gui\ImageProcTest\Services\BaselineDicomExport.cs" Link="Chain\Linked\BaselineDicomExport.cs" />
    <Compile Include="..\..\gui\ImageProcTest\Services\BaselineExecution.cs" Link="Chain\Linked\BaselineExecution.cs" />
    <Compile Include="..\..\gui\ImageProcTest\Services\BaselineAutomationRule.cs" Link="Chain\Linked\BaselineAutomationRule.cs" />
    <Compile Include="..\..\gui\ImageProcTest\Services\BaselineStageAdapters.cs" Link="Chain\Linked\BaselineStageAdapters.cs" />
    <Compile Include="..\..\gui\ImageProcTest\Services\BaselineDisplayStage.cs" Link="Chain\Linked\BaselineDisplayStage.cs" />
    <Compile Include="..\..\gui\ImageProcTest\Services\Native\GuiBaselineDisplayNative.cs" Link="Chain\Linked\GuiBaselineDisplayNative.cs" />
    <Compile Include="..\..\gui\ImageProcTest\Services\Native\XpeDicomInterop.cs" Link="Chain\Linked\XpeDicomInterop.cs" />
    <Compile Include="..\..\gui\ImageProcTest\Services\Native\GuiDicomNative.cs" Link="Chain\Linked\GuiDicomNative.cs" />
    <Compile Include="..\..\gui\ImageProcTest\Services\Native\XpeDisplayInterop.cs" Link="Chain\Linked\XpeDisplayInterop.cs" />
    <Compile Include="..\..\gui\ImageProcTest\Services\Native\XpePreprocessInterop.cs" Link="Chain\Linked\XpePreprocessInterop.cs" />
    <Compile Include="..\..\gui\ImageProcTest\Services\Native\XpeEnhanceBasicInterop.cs" Link="Chain\Linked\XpeEnhanceBasicInterop.cs" />
    <Compile Include="..\..\gui\ImageProcTest\Services\Native\GuiEnhanceNative.cs" Link="Chain\Linked\GuiEnhanceNative.cs" />
    <!--
      GUI-C-212 (#249): the legacy app's runtime smoke of xpe_preprocess.dll, called by a test. It went stale for months because nothing ran it. The records are in their own file
      (they were inside NativeReadinessProbe.cs, which drags in every other probe); PInvokeWrapper.cs is linked for the buffer/metadata types and enums only: the oracle calls the DLL
      through delegates, so XpeCommonApi's static constructor (which installs a second DllImport resolver) is never run in this assembly.
    -->
    <Compile Include="..\ImageProcTest\PInvokeWrapper.cs" Link="OracleCall\Linked\PInvokeWrapper.cs" />
    <Compile Include="..\ImageProcTest\Diagnostics\NativeDependencyLoader.cs" Link="OracleCall\Linked\NativeDependencyLoader.cs" />
    <Compile Include="..\ImageProcTest\Diagnostics\PreprocessSyntheticOracleResult.cs" Link="OracleCall\Linked\PreprocessSyntheticOracleResult.cs" />
    <Compile Include="..\ImageProcTest\Diagnostics\XpePreprocessSyntheticOracle.cs" Link="OracleCall\Linked\XpePreprocessSyntheticOracle.cs" />
  </ItemGroup>

  <!--
    DLL staging: copy xpe_common.dll and its runtime dependencies from the build output
    to the test output directory. spdlog.dll and fmt.dll are required because the native
    build links them as shared libraries (BUILD_SHARED_LIBS=ON); copying xpe_common.dll
    alone produced a loadable-looking file that failed at P/Invoke with 0x8007007E (#98).
    Dependencies are listed by name — a *.dll wildcard would also drag in gtest/gmock.
    Falls back gracefully if the build directory does not exist (CI prerequisite).
  -->
  <Target Name="CopyXpeDllsForTests" BeforeTargets="Build">
    <ItemGroup>
      <_XpeDllCandidates Include="$(MSBuildThisFileDirectory)..\..\build\ci-common\bin\Debug\xpe_common.dll" />
      <_XpeDllCandidates Include="$(MSBuildThisFileDirectory)..\..\build\ci-common\bin\xpe_common.dll" />
      <_XpeDllCandidates Include="$(MSBuildThisFileDirectory)..\..\build\default\bin\Debug\xpe_common.dll" />
      <_XpeDllCandidates Include="$(MSBuildThisFileDirectory)..\..\build\default\bin\xpe_common.dll" />
      <!--
        #202: xpe_preprocess.dll joins the staging so the whole process resolves ONE copy of each
        module. It used to be loaded out of build/… by absolute path while xpe_common.dll was copied
        here, and Windows then bound that build copy's SIBLING xpe_common — two instances of a module
        whose alert queue is global, so a push and a read landed in different queues (GUI-C-135).
        Identical md5 does not make it one instance.

        Scope is deliberate: ONLY the required modules. Copying the OPTIONAL ones (gsvg, xpe_display,
        xpe_dicom, xpe_enhance_advanced) would break
        NativeSearchPolicyTests.AllOptionalDllsAbsent_GradesEveryOptionalR0_AndNoRequiredOne, which
        pins XPE_NATIVE_DIR to a temp directory and expects those to grade R0 — the app directory is
        offered BEFORE the exclusive cut (XpeCommonLibraryLocator.cs:34), so a copy here would be found.
      -->
      <_XpeDllCandidates Include="$(MSBuildThisFileDirectory)..\..\build\ci-common\bin\Debug\xpe_preprocess.dll" />
      <_XpeDllCandidates Include="$(MSBuildThisFileDirectory)..\..\build\ci-common\bin\xpe_preprocess.dll" />
      <_XpeDllCandidates Include="$(MSBuildThisFileDirectory)..\..\build\default\bin\Debug\xpe_preprocess.dll" />
      <_XpeDllCandidates Include="$(MSBuildThisFileDirectory)..\..\build\default\bin\xpe_preprocess.dll" />
      <_XpeDllCandidates Include="$(MSBuildThisFileDirectory)..\..\build\ci-common\bin\Debug\spdlog.dll" />
      <_XpeDllCandidates Include="$(MSBuildThisFileDirectory)..\..\build\ci-common\bin\spdlog.dll" />
      <_XpeDllCandidates Include="$(MSBuildThisFileDirectory)..\..\build\default\bin\Debug\spdlog.dll" />
      <_XpeDllCandidates Include="$(MSBuildThisFileDirectory)..\..\build\default\bin\spdlog.dll" />
      <_XpeDllCandidates Include="$(MSBuildThisFileDirectory)..\..\build\ci-common\bin\Debug\fmt.dll" />
      <_XpeDllCandidates Include="$(MSBuildThisFileDirectory)..\..\build\ci-common\bin\fmt.dll" />
      <_XpeDllCandidates Include="$(MSBuildThisFileDirectory)..\..\build\default\bin\Debug\fmt.dll" />
      <_XpeDllCandidates Include="$(MSBuildThisFileDirectory)..\..\build\default\bin\fmt.dll" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_XpeDllCandidates)"
      DestinationFolder="$(OutputPath)"
      Condition="Exists('%(Identity)')"
      SkipUnchangedFiles="true"
      ContinueOnError="true" />
  </Target>

</Project>
