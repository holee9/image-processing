<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\expected-versions.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\requirement-matrix.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Linked source files for Phase 3 AI IPC Bridge UI logic (SPEC-XPE-P3-AI / Issue #83).
    These files have no WPF dependencies so they compile cleanly in this net8.0 test project.
    Tests live under AiBridgeUi/ and exercise the pure status-computer contract.
  -->
  <ItemGroup>
    <Compile Include="..\ImageProcTest\Models\ModuleReadinessSnapshot.cs" Link="AiBridgeUi\Linked\ModuleReadinessSnapshot.cs" />
    <Compile Include="..\ImageProcTest\Models\AiBridgeConnectionStatus.cs" Link="AiBridgeUi\Linked\AiBridgeConnectionStatus.cs" />
    <Compile Include="..\ImageProcTest\Models\AiBridgePanelSnapshot.cs" Link="AiBridgeUi\Linked\AiBridgePanelSnapshot.cs" />
    <Compile Include="..\ImageProcTest\Services\AiBridgeStatusComputer.cs" Link="AiBridgeUi\Linked\AiBridgeStatusComputer.cs" />
    <!--
      #128: the native-module search used by the readiness probes. Linked (not referenced) because
      the app is a net8.0-windows WinExe this net8.0 project cannot reference, and because the file
      is free of WPF and of XpeCommonApi — linking anything that touches XpeCommonApi would register
      a second DllImport resolver on this assembly and throw (measured in GUI-C-13).
    -->
    <Compile Include="..\ImageProcTest\Diagnostics\NativeModuleLibraryLocator.cs" Link="DegradedMode\Linked\NativeModuleLibraryLocator.cs" />
    <Compile Include="..\ImageProcTest\Services\ModuleReadinessGrading.cs" Link="DegradedMode\Linked\ModuleReadinessGrading.cs" />
    <Compile Include="..\ImageProcTest\Diagnostics\NativeSearchPolicy.cs" Link="DegradedMode\Linked\NativeSearchPolicy.cs" />
    <!-- #129: the enhance_basic locator, now free of the wrapper const that used to drag XpeCommonApi in. -->
    <Compile Include="..\ImageProcTest\Diagnostics\XpeEnhanceBasicLibraryLocator.cs" Link="DegradedMode\Linked\XpeEnhanceBasicLibraryLocator.cs" />
    <Compile Include="..\ImageProcTest\Diagnostics\XpePreprocessLibraryLocator.cs" Link="DegradedMode\Linked\XpePreprocessLibraryLocator.cs" />
    <Compile Include="..\ImageProcTest\Diagnostics\XpeCommonLibraryLocator.cs" Link="DegradedMode\Linked\XpeCommonLibraryLocator.cs" />
  </ItemGroup>

  <!--
    DLL staging: copy xpe_common.dll and its runtime dependencies from the build output
    to the test output directory. spdlog.dll and fmt.dll are required because the native
    build links them as shared libraries (BUILD_SHARED_LIBS=ON); copying xpe_common.dll
    alone produced a loadable-looking file that failed at P/Invoke with 0x8007007E (#98).
    Dependencies are listed by name — a *.dll wildcard would also drag in gtest/gmock.
    Falls back gracefully if the build directory does not exist (CI prerequisite).
  -->
  <Target Name="CopyXpeDllsForTests" BeforeTargets="Build">
    <ItemGroup>
      <_XpeDllCandidates Include="$(MSBuildThisFileDirectory)..\..\build\ci-common\bin\Debug\xpe_common.dll" />
      <_XpeDllCandidates Include="$(MSBuildThisFileDirectory)..\..\build\ci-common\bin\xpe_common.dll" />
      <_XpeDllCandidates Include="$(MSBuildThisFileDirectory)..\..\build\default\bin\Debug\xpe_common.dll" />
      <_XpeDllCandidates Include="$(MSBuildThisFileDirectory)..\..\build\default\bin\xpe_common.dll" />
      <_XpeDllCandidates Include="$(MSBuildThisFileDirectory)..\..\build\ci-common\bin\Debug\spdlog.dll" />
      <_XpeDllCandidates Include="$(MSBuildThisFileDirectory)..\..\build\ci-common\bin\spdlog.dll" />
      <_XpeDllCandidates Include="$(MSBuildThisFileDirectory)..\..\build\default\bin\Debug\spdlog.dll" />
      <_XpeDllCandidates Include="$(MSBuildThisFileDirectory)..\..\build\default\bin\spdlog.dll" />
      <_XpeDllCandidates Include="$(MSBuildThisFileDirectory)..\..\build\ci-common\bin\Debug\fmt.dll" />
      <_XpeDllCandidates Include="$(MSBuildThisFileDirectory)..\..\build\ci-common\bin\fmt.dll" />
      <_XpeDllCandidates Include="$(MSBuildThisFileDirectory)..\..\build\default\bin\Debug\fmt.dll" />
      <_XpeDllCandidates Include="$(MSBuildThisFileDirectory)..\..\build\default\bin\fmt.dll" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_XpeDllCandidates)"
      DestinationFolder="$(OutputPath)"
      Condition="Exists('%(Identity)')"
      SkipUnchangedFiles="true"
      ContinueOnError="true" />
  </Target>

</Project>
