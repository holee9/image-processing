<UserControl x:Class="ImageProcTest.Controls.HistogramControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="64">
    <Border Background="#FF0D1117"
            BorderBrush="#FF30363D"
            BorderThickness="1"
            Padding="4">
        <Canvas x:Name="HistogramCanvas"
                Background="Transparent"
                ClipToBounds="True"
                Cursor="SizeWE"
                MouseLeftButtonDown="HistogramCanvas_MouseLeftButtonDown"
                MouseLeftButtonUp="HistogramCanvas_MouseLeftButtonUp"
                MouseMove="HistogramCanvas_MouseMove"
                MouseLeave="HistogramCanvas_MouseLeave"/>
    </Border>
</UserControl>
