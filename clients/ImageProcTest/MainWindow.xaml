<Window x:Class="ImageProcTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ImageProcTest.Controls"
        Title="XPE Image Processing Test" Height="860" Width="1240"
        Loaded="Window_Loaded" Closed="Window_Closed" KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0"
              AutomationProperties.AutomationId="XPE_Menu_Main_Menu"
              AutomationProperties.Name="Main menu">
            <MenuItem Header="_File" AutomationProperties.AutomationId="XPE_Menu_File_MenuItem">
                <MenuItem Header="_Open Raw..."
                          InputGestureText="Ctrl+O"
                          Click="MenuOpenRaw_Click"
                          AutomationProperties.AutomationId="XPE_Menu_File_OpenRaw_MenuItem"
                          AutomationProperties.Name="Open raw image"/>
                <MenuItem Header="_Save Evidence Report"
                          InputGestureText="Ctrl+S"
                          Click="MenuSaveEvidenceReport_Click"
                          AutomationProperties.AutomationId="XPE_Menu_File_SaveEvidence_MenuItem"
                          AutomationProperties.Name="Save evidence report"/>
                <Separator/>
                <MenuItem Header="E_xit"
                          Click="MenuExit_Click"
                          AutomationProperties.AutomationId="XPE_Menu_File_Exit_MenuItem"
                          AutomationProperties.Name="Exit application"/>
            </MenuItem>
            <MenuItem Header="_Backend" AutomationProperties.AutomationId="XPE_Menu_Backend_MenuItem">
                <MenuItem Header="_Refresh Native Diagnostics"
                          Click="MenuRefreshNativeDiagnostics_Click"
                          AutomationProperties.AutomationId="XPE_Menu_Backend_RefreshDiagnostics_MenuItem"
                          AutomationProperties.Name="Refresh native diagnostics"/>
                <MenuItem Header="Run _P/Invoke Smoke Test"
                          Click="MenuRunSmokeTest_Click"
                          AutomationProperties.AutomationId="XPE_Menu_Backend_RunSmoke_MenuItem"
                          AutomationProperties.Name="Run P/Invoke smoke test"/>
            </MenuItem>
            <MenuItem Header="_View" AutomationProperties.AutomationId="XPE_Menu_View_MenuItem">
                <MenuItem Header="_Evaluation"
                          Click="MenuShowEvaluation_Click"
                          AutomationProperties.AutomationId="XPE_Menu_View_ShowEvaluation_MenuItem"
                          AutomationProperties.Name="Show evaluation tab"/>
                <MenuItem Header="_Calibration"
                          Click="MenuShowCalibration_Click"
                          AutomationProperties.AutomationId="XPE_Menu_View_ShowCalibration_MenuItem"
                          AutomationProperties.Name="Show calibration tab"/>
                <MenuItem Header="_Metrics"
                          Click="MenuShowMetrics_Click"
                          AutomationProperties.AutomationId="XPE_Menu_View_ShowMetrics_MenuItem"
                          AutomationProperties.Name="Show metrics tab"/>
                <MenuItem Header="_Reports"
                          Click="MenuShowReports_Click"
                          AutomationProperties.AutomationId="XPE_Menu_View_ShowReports_MenuItem"
                          AutomationProperties.Name="Show reports tab"/>
                <MenuItem Header="_Diagnostics"
                          Click="MenuShowDiagnostics_Click"
                          AutomationProperties.AutomationId="XPE_Menu_View_ShowDiagnostics_MenuItem"
                          AutomationProperties.Name="Show diagnostics tab"/>
                <Separator/>
                <MenuItem Header="Zoom _Fit"
                          Click="MenuZoomFit_Click"
                          AutomationProperties.AutomationId="XPE_Menu_View_ZoomFit_MenuItem"
                          AutomationProperties.Name="Zoom fit"/>
                <MenuItem Header="Zoom _100%"
                          Click="MenuZoomActual_Click"
                          AutomationProperties.AutomationId="XPE_Menu_View_ZoomActual_MenuItem"
                          AutomationProperties.Name="Zoom 100 percent"/>
                <MenuItem Header="Zoom _In"
                          Click="MenuZoomIn_Click"
                          AutomationProperties.AutomationId="XPE_Menu_View_ZoomIn_MenuItem"
                          AutomationProperties.Name="Zoom in"/>
                <MenuItem Header="Zoom _Out"
                          Click="MenuZoomOut_Click"
                          AutomationProperties.AutomationId="XPE_Menu_View_ZoomOut_MenuItem"
                          AutomationProperties.Name="Zoom out"/>
                <MenuItem Header="_Reset Layout"
                          Click="MenuResetLayout_Click"
                          AutomationProperties.AutomationId="XPE_Menu_View_ResetLayout_MenuItem"
                          AutomationProperties.Name="Reset layout"/>
            </MenuItem>
            <MenuItem Header="_Pipeline" AutomationProperties.AutomationId="XPE_Menu_Pipeline_MenuItem">
                <MenuItem Header="_Run Preprocessing"
                          IsEnabled="False"
                          ToolTip="Disabled until owner DLL and command adapter are available."
                          AutomationProperties.AutomationId="XPE_Menu_Pipeline_RunPreprocessing_MenuItem"
                          AutomationProperties.Name="Run preprocessing"/>
                <MenuItem Header="Run _Full Pipeline"
                          IsEnabled="False"
                          ToolTip="Disabled until pipeline owner DLLs are available."
                          AutomationProperties.AutomationId="XPE_Menu_Pipeline_RunFullPipeline_MenuItem"
                          AutomationProperties.Name="Run full pipeline"/>
                <MenuItem Header="_Stop Processing"
                          IsEnabled="False"
                          ToolTip="No active pipeline command is running."
                          AutomationProperties.AutomationId="XPE_Menu_Pipeline_Stop_MenuItem"
                          AutomationProperties.Name="Stop processing"/>
            </MenuItem>
            <MenuItem Header="_Tools" AutomationProperties.AutomationId="XPE_Menu_Tools_MenuItem">
                <MenuItem Header="_Calibration Evaluation"
                          Click="MenuShowEvaluation_Click"
                          AutomationProperties.AutomationId="XPE_Menu_Tools_CalibrationEvaluation_MenuItem"
                          AutomationProperties.Name="Calibration evaluation"/>
                <MenuItem Header="_Open Evidence Folder"
                          Click="MenuOpenEvidenceFolder_Click"
                          AutomationProperties.AutomationId="XPE_Menu_Tools_OpenEvidenceFolder_MenuItem"
                          AutomationProperties.Name="Open evidence folder"/>
            </MenuItem>
            <MenuItem Header="_Help" AutomationProperties.AutomationId="XPE_Menu_Help_MenuItem">
                <MenuItem Header="_Help Home"
                          InputGestureText="F1"
                          Click="MenuHelpHome_Click"
                          AutomationProperties.AutomationId="XPE_Menu_Help_Home_MenuItem"
                          AutomationProperties.Name="Help home"/>
                <MenuItem Header="_Quick Start"
                          Click="MenuHelpHome_Click"
                          AutomationProperties.AutomationId="XPE_Menu_Help_QuickStart_MenuItem"
                          AutomationProperties.Name="Quick start"/>
                <MenuItem Header="_Scope and Limitations"
                          Click="MenuHelpHome_Click"
                          AutomationProperties.AutomationId="XPE_Menu_Help_Scope_MenuItem"
                          AutomationProperties.Name="Scope and limitations"/>
                <MenuItem Header="_About / Build Info"
                          Click="MenuHelpHome_Click"
                          AutomationProperties.AutomationId="XPE_Menu_Help_About_MenuItem"
                          AutomationProperties.Name="About and build info"/>
            </MenuItem>
        </Menu>

        <!-- Header -->
        <Border Grid.Row="1" Background="#FF2C3E50" Padding="12">
            <StackPanel>
                <TextBlock Text="XPE Image Processing Engine Test" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="VersionText" Text="Version: Loading..." FontSize="12" Foreground="#FFECF0F1" Margin="0,5,0,0"/>
                <TextBlock x:Name="StatusText" Text="Status: Initializing..." FontSize="12" Foreground="#FFECF0F1" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Tab Area -->
        <TabControl x:Name="MainTabControl" Grid.Row="2" Margin="8">

            <!-- ===== EVALUATION TAB (viewer-first) ===== -->
            <TabItem Header="Evaluation">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FFF6F8FA" BorderBrush="#FFD0D7DE" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Evaluation Workbench" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ActiveContextSummaryText"
                                           Text="No calibration folder, target raw, or algorithm chain is ready."
                                           FontSize="12"
                                           Foreground="#FF57606A"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0"/>
                                <TextBlock x:Name="ActiveContextDetailsText"
                                           Text="Use Calibration to select the acquired calibration folder, target raw image, and ordered algorithm chain."
                                           FontSize="11"
                                           Foreground="#FF57606A"
                                           TextWrapping="Wrap"
                                           Margin="0,1,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Button Content="Calibration Setup"
                                        Width="136"
                                        Height="30"
                                        Click="OpenCalibrationSetupButton_Click"
                                        Margin="0,0,8,0"/>
                                <Button x:Name="WorkflowRunButton"
                                        Content="Run Chain"
                                        Width="112"
                                        Height="30"
                                        IsEnabled="False"
                                        Click="WorkflowRunButton_Click"
                                        Margin="0,0,8,0"/>
                                <Button x:Name="WorkflowCancelButton"
                                        Content="Cancel"
                                        Width="84"
                                        Height="30"
                                        IsEnabled="False"
                                        Click="WorkflowCancelButton_Click"
                                        Margin="0,0,8,0"/>
                                <Button Content="Save Evidence"
                                        Width="116"
                                        Height="30"
                                        Click="SaveE2eReportButton_Click"/>
                            </StackPanel>

                            <Border Grid.Row="1" Grid.ColumnSpan="2"
                                    BorderBrush="#FFD0D7DE"
                                    BorderThickness="1"
                                    Background="#FFFFFFFF"
                                    CornerRadius="3"
                                    Padding="8"
                                    Margin="0,10,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="Processing Stages"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>
                                    <UniformGrid Grid.Row="0" Grid.Column="1" Columns="4" VerticalAlignment="Center">
                                        <CheckBox x:Name="OffsetEnabledCheckBox"
                                                  Content="Pre Offset"
                                                  IsEnabled="False"
                                                  Checked="StageSelection_Changed"
                                                  Unchecked="StageSelection_Changed"
                                                  Margin="0,0,10,0"/>
                                        <CheckBox x:Name="GainEnabledCheckBox"
                                                  Content="Pre Gain"
                                                  IsEnabled="False"
                                                  Checked="StageSelection_Changed"
                                                  Unchecked="StageSelection_Changed"
                                                  Margin="0,0,10,0"/>
                                        <CheckBox x:Name="DefectEnabledCheckBox"
                                                  Content="Pre Defect"
                                                  IsEnabled="False"
                                                  Checked="StageSelection_Changed"
                                                  Unchecked="StageSelection_Changed"
                                                  Margin="0,0,10,0"/>
                                        <CheckBox x:Name="EiEnabledCheckBox"
                                                  Content="Post EI"
                                                  IsEnabled="False"
                                                  Checked="StageSelection_Changed"
                                                  Unchecked="StageSelection_Changed"/>
                                        <CheckBox x:Name="LogEnabledCheckBox"
                                                  Content="Post Log"
                                                  IsEnabled="False"
                                                  Checked="StageSelection_Changed"
                                                  Unchecked="StageSelection_Changed"
                                                  Margin="0,4,10,0"/>
                                        <CheckBox x:Name="NoiseEnabledCheckBox"
                                                  Content="Post Noise"
                                                  IsEnabled="False"
                                                  Checked="StageSelection_Changed"
                                                  Unchecked="StageSelection_Changed"
                                                  Margin="0,4,10,0"/>
                                        <CheckBox x:Name="ContrastEnabledCheckBox"
                                                  Content="Post Contrast"
                                                  IsEnabled="False"
                                                  Checked="StageSelection_Changed"
                                                  Unchecked="StageSelection_Changed"
                                                  Margin="0,4,10,0"/>
                                        <CheckBox x:Name="EdgeEnabledCheckBox"
                                                  Content="Post Edge"
                                                  IsEnabled="False"
                                                  Checked="StageSelection_Changed"
                                                  Unchecked="StageSelection_Changed"
                                                  Margin="0,4,0,0"/>
                                    </UniformGrid>
                                    <Button x:Name="ApplyNativePreviewButton"
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            Content="Run Selected"
                                            Width="118"
                                            Height="30"
                                            IsEnabled="False"
                                            Click="ApplyNativePreviewButton_Click"
                                            Margin="12,0,0,0"/>
                                    <UniformGrid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Columns="5" Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                            <TextBlock Text="Log norm" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBox x:Name="LogNormFactorTextBox" Text="1000" Width="58"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                            <TextBlock Text="Noise s/r" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBox x:Name="NoiseSigmaSpaceTextBox" Text="3.0" Width="42" Margin="0,0,4,0"/>
                                            <TextBox x:Name="NoiseSigmaRangeTextBox" Text="50.0" Width="48"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                            <TextBlock Text="CLAHE clip" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBox x:Name="ClaheClipLimitTextBox" Text="3.0" Width="42"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                            <TextBlock Text="USM a/r/t" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBox x:Name="UsmAmountTextBox" Text="0.5" Width="38" Margin="0,0,4,0"/>
                                            <TextBox x:Name="UsmRadiusTextBox" Text="2.0" Width="38" Margin="0,0,4,0"/>
                                            <TextBox x:Name="UsmThresholdTextBox" Text="10.0" Width="46"/>
                                        </StackPanel>
                                        <TextBlock Text="Post uses pre output when selected, otherwise raw→float input."
                                                   FontSize="11"
                                                   Foreground="#FF57606A"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                    </UniformGrid>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                <TextBlock x:Name="StageModesInfoText"
                                           Text="Offset/Gain/Defect apply switches are disabled until native preprocess readiness passes."
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="#FF57606A"/>
                                <TextBlock x:Name="NativePreviewText"
                                           Text="Native preview: unavailable"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0"/>
                                <TextBlock x:Name="E2eReportText"
                                           Text="E2E report: not saved"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <controls:EvaluationViewerPanel x:Name="EvaluationViewer" Grid.Row="1"/>

                    <Border Grid.Row="2"
                            Background="#FFF6F8FA"
                            BorderBrush="#FFD0D7DE"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8"
                            Margin="0,10,0,10">
                        <TextBlock x:Name="WorkflowBeforeAfterText"
                                   Text="No run yet. Configure calibration inputs, load a target raw, then run the selected algorithm chain."
                                   Foreground="#FF57606A"
                                   FontSize="12"
                                   FontFamily="Consolas"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <Border Grid.Row="3" BorderBrush="#FFD0D7DE" BorderThickness="1" CornerRadius="4" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="User Evaluation" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Evaluator" Width="90" VerticalAlignment="Center"/>
                                <TextBox x:Name="EvaluatorTextBox" Width="180" Margin="0,0,18,0"/>
                                <TextBlock Text="Verdict" Width="70" VerticalAlignment="Center"/>
                                <RadioButton x:Name="UserPassRadio" Content="Pass" GroupName="UserVerdict" Margin="0,0,10,0" IsChecked="True"/>
                                <RadioButton x:Name="UserReviewRadio" Content="Needs review" GroupName="UserVerdict" Margin="0,0,10,0"/>
                                <RadioButton x:Name="UserFailRadio" Content="Fail" GroupName="UserVerdict" Margin="0,0,18,0"/>
                                <Button Content="Record Evaluation"
                                        Width="140"
                                        Click="RecordUserEvaluationButton_Click"
                                        Margin="0,0,8,0"/>
                            </StackPanel>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="260"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="UserEvaluationNotesTextBox"
                                         Grid.Column="0"
                                         AcceptsReturn="True"
                                         Height="58"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"/>
                                <TextBlock x:Name="UserEvaluationStatusText"
                                           Grid.Column="1"
                                           Text="User evaluation: not recorded."
                                           FontSize="12"
                                           Foreground="#FF57606A"
                                           TextWrapping="Wrap"
                                           Margin="10,0,0,0"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===== CALIBRATION TAB ===== -->
            <TabItem Header="Calibration">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <TextBlock Text="Calibration Setup" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>

                        <Border BorderBrush="#FFD0D7DE" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                                           Text="Select the acquired calibration folder and the target raw image. Sample datasets remain internal regression inputs only."
                                           FontSize="12" Foreground="#FF57606A" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Calibration folder" VerticalAlignment="Center" Margin="0,0,8,6"/>
                                <TextBox x:Name="WorkflowCalibrationFolderText"
                                         Grid.Row="1" Grid.Column="1"
                                         IsReadOnly="True"
                                         Text="No calibration folder selected"
                                         VerticalAlignment="Center"
                                         Padding="4"
                                         Margin="0,0,8,6"/>
                                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button x:Name="WorkflowBrowseCalibrationFolderButton"
                                            Content="Browse..."
                                            Width="82"
                                            Click="WorkflowBrowseCalibrationFolderButton_Click"
                                            Margin="0,0,6,0"/>
                                    <Button x:Name="WorkflowRefreshCalibrationFolderButton"
                                            Content="Refresh"
                                            Width="74"
                                            Click="WorkflowRefreshCalibrationFolderButton_Click"/>
                                </StackPanel>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Cal files" VerticalAlignment="Center" Margin="0,0,8,6"/>
                                <ListBox x:Name="WorkflowCalibrationFilesListBox"
                                         Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                         DisplayMemberPath="DisplayName"
                                         Height="96"
                                         Margin="0,0,0,6"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Target raw" VerticalAlignment="Center" Margin="0,0,8,6"/>
                                <TextBox x:Name="WorkflowFilePathText"
                                         Grid.Row="3" Grid.Column="1"
                                         IsReadOnly="True"
                                         Text="No file selected"
                                         VerticalAlignment="Center"
                                         Padding="4"
                                         Margin="0,0,8,6"/>
                                <Button x:Name="WorkflowBrowseButton"
                                        Grid.Row="3" Grid.Column="2"
                                        Content="Load Raw..."
                                        Width="90"
                                        Click="WorkflowBrowseButton_Click"/>

                                <TextBlock x:Name="WorkflowCalibrationContextText"
                                           Grid.Row="4" Grid.ColumnSpan="3"
                                           Text="Calibration context: no folder selected. Use the folder acquired per IAP-CALIB-001; offset/dark and gain/flat are mandatory for product-mode correction."
                                           FontSize="12"
                                           Foreground="#FF57606A"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"/>
                                <TextBlock x:Name="WorkflowAcquisitionGuideText"
                                           Grid.Row="5" Grid.ColumnSpan="3"
                                           Text="Acquisition guide: Dark/Offset raw is acquired with X-ray OFF; Gain/Flat raw is acquired from flat-field exposure with matching dark; BPM/Defect map is optional for defect correction but required for defect SWU validation."
                                           FontSize="12"
                                           Foreground="#FF57606A"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                            </Grid>
                        </Border>

                        <Border BorderBrush="#FFD0D7DE" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Ordered Algorithm Chain" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Available algorithms" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Selected evaluation chain" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <ListBox x:Name="AvailableAlgorithmListBox"
                                         Grid.Row="2" Grid.Column="0"
                                         DisplayMemberPath="DisplayName"
                                         Height="170"
                                         MinWidth="330"
                                         Margin="0,0,8,0"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Width="94" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Button Content="Add &gt;" Height="26" Click="AddAlgorithmToChain_Click" Margin="0,0,0,6"/>
                                    <Button Content="&lt; Remove" Height="26" Click="RemoveAlgorithmFromChain_Click" Margin="0,0,0,12"/>
                                    <Button Content="Move up" Height="26" Click="MoveAlgorithmUp_Click" Margin="0,0,0,6"/>
                                    <Button Content="Move down" Height="26" Click="MoveAlgorithmDown_Click"/>
                                </StackPanel>
                                <ListBox x:Name="SelectedAlgorithmChainListBox"
                                         Grid.Row="2" Grid.Column="2"
                                         DisplayMemberPath="ChainDisplayName"
                                         Height="170"
                                         MinWidth="330"
                                         SelectionChanged="SelectedAlgorithmChainListBox_SelectionChanged"/>
                                <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Runnable preprocess" Width="138" Height="28" Click="UseRunnablePreprocessChain_Click" Margin="0,0,8,0"/>
                                        <Button Content="Post basic" Width="92" Height="28" Click="UseRunnablePostBasicChain_Click" Margin="0,0,8,0"/>
                                        <Button Content="Phase 1b E2E" Width="116" Height="28" Click="UseRunnablePrePostBasicChain_Click" Margin="0,0,8,0"/>
                                        <Button Content="Product canonical" Width="132" Height="28" Click="UseProductCanonicalChain_Click" Margin="0,0,8,0"/>
                                        <Button Content="Pre-E2E proof" Width="110" Height="28" Click="UsePreE2eProofChain_Click" Margin="0,0,8,0"/>
                                        <Button Content="Clear" Width="72" Height="28" Click="ClearAlgorithmChain_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="WorkflowAlgorithmStatusText"
                                               Text="Algorithm chain: select one or more stages."
                                               FontSize="12"
                                               Foreground="#FF57606A"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0"/>
                                    <DataGrid x:Name="WorkflowRuleFindingsGrid"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              MinHeight="90"
                                              MaxHeight="150"
                                              Margin="0,8,0,0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Severity" Binding="{Binding SeverityText}" Width="90"/>
                                            <DataGridTextColumn Header="Rule" Binding="{Binding RuleId}" Width="140"/>
                                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                                            <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="260"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border BorderBrush="#FFD0D7DE" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Evaluation Stage Switches" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="Calibration keeps folder, file role audit, target raw, and algorithm chain preparation. Offset/Gain/Defect Apply/Skip switches are in the Evaluation workbench so the reviewer can rerun selected stages while comparing the image."
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="#FF57606A"/>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#FFD0D7DE" BorderThickness="1" CornerRadius="4" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="Calibration Validation Matrix" FontSize="16" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button Content="Refresh" Width="90" Margin="0,0,8,0" Click="RefreshAlgorithmsButton_Click"/>
                                        <Button x:Name="RunSelectedAlgorithmButton"
                                                Content="Run Selected"
                                                Width="120"
                                                Click="RunSelectedAlgorithmValidationButton_Click"/>
                                    </StackPanel>
                                </DockPanel>

                                <DataGrid Grid.Row="1"
                                          x:Name="AlgorithmValidationGrid"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          MinHeight="230"
                                          MaxHeight="360"
                                          SelectionChanged="AlgorithmValidationGrid_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Module" Binding="{Binding ModuleName}" Width="125"/>
                                        <DataGridTextColumn Header="SWU" Binding="{Binding SwuId}" Width="90"/>
                                        <DataGridTextColumn Header="Calibration Unit" Binding="{Binding AlgorithmName}" Width="210"/>
                                        <DataGridTextColumn Header="Req" Binding="{Binding RequirementIds}" Width="170"/>
                                        <DataGridTextColumn Header="Tests" Binding="{Binding TestIds}" Width="190"/>
                                        <DataGridTextColumn Header="Gate" Binding="{Binding Gate}" Width="90"/>
                                        <DataGridTextColumn Header="Adapter" Binding="{Binding Adapter}" Width="120"/>
                                        <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="60"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140"/>
                                        <DataGridCheckBoxColumn Header="Run" Binding="{Binding CanRun}" Width="55"/>
                                        <DataGridTextColumn Header="Next" Binding="{Binding NextAction}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Grid.Row="2"
                                           x:Name="AlgorithmValidationResultText"
                                           Text="Calibration validation: not checked"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"/>
                            </Grid>
                        </Border>

                        <Grid Visibility="Collapsed">
                            <ComboBox x:Name="FixtureCaseComboBox"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="FixtureCaseComboBox_SelectionChanged"/>
                            <TextBlock x:Name="SelectedCaseText" Text="Selected case: none"/>
                            <ListBox x:Name="ImageFilesListBox"
                                     DisplayMemberPath="DisplayName"
                                     SelectionChanged="ImageFilesListBox_SelectionChanged"/>
                            <ListBox x:Name="CalibrationFilesListBox" DisplayMemberPath="DisplayName"/>
                            <Button Content="Load Selected Raw" Click="LoadSelectedRawButton_Click"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== DIAGNOSTICS TAB (moved from default) ===== -->
            <TabItem Header="Diagnostics">
                <ScrollViewer>
                    <StackPanel Margin="10">

                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Native Common Health" FontSize="16" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                            <Button Content="Refresh" Width="90" DockPanel.Dock="Right" Click="RefreshButton_Click"/>
                        </DockPanel>

                        <Border Background="#FFF6F8FA" BorderBrush="#FFD0D7DE" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Why this screen exists" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="This is an integration safety dashboard, not an image-processing feature screen. It verifies that the GUI can safely load and call xpe_common.dll before preprocess, display, DICOM, GSVG, or AI modules are connected." TextWrapping="Wrap" FontSize="13" Margin="0,0,0,6"/>
                                <TextBlock Text="How to read it" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,4"/>
                                <TextBlock Text="Ready means the native common DLL loaded and basic ABI calls succeeded. Unavailable means the GUI is running safely without native common. Entry point mismatch means the DLL and C# P/Invoke contract disagree. Image-processing modules remain gated until their own readiness checks pass." TextWrapping="Wrap" FontSize="13"/>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#FFD0D7DE" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="NativePathText" Text="DLL: Not checked" FontSize="13" Margin="0,0,0,5"/>
                                <TextBlock x:Name="InitText" Text="Init: Not checked" FontSize="13" Margin="0,0,0,5"/>
                                <TextBlock x:Name="VersionCheckText" Text="Version: Not checked" FontSize="13" Margin="0,0,0,5"/>
                                <TextBlock x:Name="ParamRangeText" Text="Param range: Not checked" FontSize="13" Margin="0,0,0,5"/>
                                <TextBlock x:Name="MemoryAbiText" Text="Memory ABI: Not checked" FontSize="13" Margin="0,0,0,5"/>
                                <TextBlock x:Name="AlertText" Text="Alerts: Not checked" FontSize="13" Margin="0,0,0,5"/>
                                <TextBlock x:Name="DisplayHealthText" Text="Display health: Not checked" FontSize="13" Margin="0,0,0,5"/>
                                <TextBlock x:Name="DicomHealthText" Text="DICOM health: Not checked" FontSize="13" Margin="0,0,0,5"/>
                                <TextBlock x:Name="GsvgHealthText" Text="GSVG health: Not checked" FontSize="13" Margin="0,0,0,5"/>
                                <TextBlock x:Name="PreprocessHealthText" Text="Preprocess health: Not checked" FontSize="13" Margin="0,0,0,5"/>
                                <TextBlock x:Name="PreprocessSmokeText" Text="Preprocess smoke: Not checked" FontSize="13" Margin="0,0,0,5"/>
                                <TextBlock x:Name="PreprocessParamRangeText" Text="Preprocess parameter ranges: Not checked" FontSize="13" Margin="0,0,0,5" TextWrapping="Wrap"/>
                                <DataGrid x:Name="PreprocessParamRangeGrid"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          MinHeight="72"
                                          MaxHeight="160"
                                          Margin="0,0,0,6">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Parameter" Binding="{Binding ParamName}" Width="170"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding ErrorCode}" Width="90"/>
                                        <DataGridTextColumn Header="Min" Binding="{Binding MinValue, StringFormat={}{0:0.###}}" Width="80"/>
                                        <DataGridTextColumn Header="Max" Binding="{Binding MaxValue, StringFormat={}{0:0.###}}" Width="80"/>
                                        <DataGridCheckBoxColumn Header="OK" Binding="{Binding Passed}" Width="50"/>
                                        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="ReportText" Text="Readiness report: Not generated" FontSize="13" Margin="0,0,0,5"/>
                                <TextBlock x:Name="DetailsText" Text="Details: Waiting for health check." FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Integration policy" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,4"/>
                        <TextBlock Text="This screen verifies common, preprocess, enhance, display, DICOM, GSVG, and AI readiness. Missing DLLs or future modules stay Off and are skipped without stopping the available preview adapters." TextWrapping="Wrap" FontSize="13"/>

                        <Separator Margin="0,16,0,12"/>

                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Module Readiness Matrix" FontSize="16" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                            <Button Content="Refresh Modules" Width="120" DockPanel.Dock="Right" Click="RefreshModulesButton_Click"/>
                        </DockPanel>

                        <Border Background="#FFF6F8FA" BorderBrush="#FFD0D7DE" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="R0 means not ready, R1 means version/binary health only, R2 means export/ABI smoke ready, and R3+ means executable oracle evidence. Processing controls stay disabled unless a module reaches the required gate." TextWrapping="Wrap" FontSize="13" Margin="0,0,0,8"/>
                                <DataGrid x:Name="ModuleReadinessGrid"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          Height="210">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Module" Binding="{Binding ModuleName}" Width="130"/>
                                        <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="60"/>
                                        <DataGridTextColumn Header="Meaning" Binding="{Binding LevelDescription}" Width="150"/>
                                        <DataGridTextColumn Header="Req" Binding="{Binding RequiredLevel}" Width="55"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="210"/>
                                        <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="*"/>
                                        <DataGridTextColumn Header="Exec" Binding="{Binding ExecutionState}" Width="75"/>
                                        <DataGridTextColumn Header="Degraded mode" Binding="{Binding DegradationReason}" Width="280"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="ModuleReadinessSummaryText"
                                           Text="Module readiness: not checked"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Separator Margin="0,16,0,12"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== METRICS TAB ===== -->
            <TabItem Header="Metrics">
                <ScrollViewer>
                    <StackPanel Margin="16">
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Metrics" FontSize="18" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                            <Button Content="Refresh" Width="90" DockPanel.Dock="Right" Click="RefreshButton_Click"/>
                        </DockPanel>
                        <TextBlock x:Name="MetricsSummaryText"
                                   Text="Metrics: waiting for native readiness and calibration preview."
                                   FontSize="13"
                                   Foreground="#FF57606A"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="Evaluation Gates" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <DataGrid x:Name="EvaluationMetricsGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  MinHeight="180"
                                  MaxHeight="260"
                                  Margin="0,0,0,14">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Area" Binding="{Binding Area}" Width="150"/>
                                <DataGridTextColumn Header="Metric" Binding="{Binding Metric}" Width="210"/>
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                                <DataGridTextColumn Header="Gate" Binding="{Binding Gate}" Width="180"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Stage Latency" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <DataGrid x:Name="StageLatencyGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  MinHeight="110"
                                  MaxHeight="190"
                                  Margin="0,0,0,14">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="130"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                                <DataGridCheckBoxColumn Header="Exec" Binding="{Binding Executed}" Width="60"/>
                                <DataGridTextColumn Header="Latency" Binding="{Binding LatencyMs}" Width="100"/>
                                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Calibration Loads" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <DataGrid x:Name="CalibrationMetricsGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  MinHeight="110"
                                  MaxHeight="220"
                                  Margin="0,0,0,14">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="110"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                                <DataGridCheckBoxColumn Header="Loaded" Binding="{Binding Loaded}" Width="70"/>
                                <DataGridTextColumn Header="Latency" Binding="{Binding LatencyMs}" Width="100"/>
                                <DataGridTextColumn Header="Expiry" Binding="{Binding Expiry}" Width="160"/>
                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Detector-Domain Dark Metrics" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <DataGrid x:Name="DarkMetricsGrid"
                                  AutomationProperties.AutomationId="DarkMetricsGrid"
                                  AutomationProperties.Name="Detector-domain dark metrics"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  MinHeight="100"
                                  MaxHeight="160"
                                  Margin="0,0,0,14">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Metric" Binding="{Binding Metric}" Width="180"/>
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="160"/>
                                <DataGridTextColumn Header="Gate" Binding="{Binding Gate}" Width="180"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Detector-Domain Flat Metrics" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <DataGrid x:Name="FlatMetricsGrid"
                                  AutomationProperties.AutomationId="FlatMetricsGrid"
                                  AutomationProperties.Name="Detector-domain flat metrics"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  MinHeight="110"
                                  MaxHeight="180"
                                  Margin="0,0,0,14">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Metric" Binding="{Binding Metric}" Width="180"/>
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="160"/>
                                <DataGridTextColumn Header="Gate" Binding="{Binding Gate}" Width="180"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Defect / BPM Metrics" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <DataGrid x:Name="DefectMetricsGrid"
                                  AutomationProperties.AutomationId="DefectMetricsGrid"
                                  AutomationProperties.Name="Defect and BPM metrics"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  MinHeight="100"
                                  MaxHeight="170">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Metric" Binding="{Binding Metric}" Width="180"/>
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="160"/>
                                <DataGridTextColumn Header="Gate" Binding="{Binding Gate}" Width="180"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== REPORTS TAB ===== -->
            <TabItem Header="Reports">
                <ScrollViewer>
                    <StackPanel Margin="16">
                        <TextBlock Text="Reports" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Save Current GUI Report"
                                    Width="170"
                                    Height="30"
                                    Click="SaveE2eReportButton_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="ReportsSummaryText"
                                   Text="Reports: no report generated in this session."
                                   FontSize="13"
                                   Foreground="#FF57606A"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6"/>
                        <DataGrid x:Name="ReportArtifactsGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  MinHeight="180">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="210"/>
                                <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== HELP TAB ===== -->
            <TabItem Header="Help">
                <ScrollViewer>
                    <StackPanel Margin="16">
                        <TextBlock Text="Evaluation Help" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <TextBlock Text="Calibration selection" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Use the Calibration tab to select the acquired calibration folder first. The app audits dark/offset, gain/flat, BPM/defect, reference, and unknown files before allowing correction runs."
                                   TextWrapping="Wrap" FontSize="13" Margin="0,0,0,12"/>

                        <TextBlock Text="Visual comparison" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Load the target raw image from Calibration, then use Offset/Gain/Defect Apply switches in Evaluation and run the selected stages. The viewer keeps original and applied images aligned to the raw image dimensions; drag across the image for direct comparison, right-drag to pan, or use Zoom and Swipe for pixel inspection."
                                   TextWrapping="Wrap" FontSize="13" Margin="0,0,0,12"/>

                        <TextBlock Text="User verdict" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="After visual review, record the evaluator, verdict, and notes. Save Evidence Report writes the calibration run, raw hash, metrics, readiness, and user verdict into the report artifacts."
                                   TextWrapping="Wrap" FontSize="13" Margin="0,0,0,12"/>

                        <TextBlock Text="Supporting tabs" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Calibration owns folders, files, chain order, and SWU gates. Evaluation owns stage Apply/Skip switches, visual review, and user verdicts. Metrics shows run evidence. Reports stores generated artifacts. Diagnostics only shows native readiness and integration health."
                                   TextWrapping="Wrap" FontSize="13"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
