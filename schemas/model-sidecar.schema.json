{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model-sidecar.schema.json",
  "title": "XPE AI model sidecar <name>.json (REQ-AI-008)",
  "description": "The JSON beside a model file. It is covered by the model's signature and read only after the signature verified. Required: the five fields of REQ-AI-008. Optional: the inputs of the model card (REQ-AI-010). Other keys are allowed and not judged (labels of a body-part model, note). Two rules a JSON Schema cannot state, which the module also applies: a top-level key may not appear twice, and published_date must be a real calendar date.",
  "type": "object",
  "required": ["model_id", "version", "pccp_scope", "training_data_hash", "validation_metrics"],
  "properties": {
    "model_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "version": {
      "description": "Semantic Versioning 2.0.0.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "pccp_scope": {
      "type": "string",
      "minLength": 1
    },
    "training_data_hash": {
      "type": "string",
      "minLength": 1
    },
    "validation_metrics": {
      "type": "object",
      "minProperties": 1
    },
    "intended_use": {
      "type": "string"
    },
    "training_data_summary": {
      "type": "string"
    },
    "demographic_performance": {
      "type": "object"
    },
    "limitations": {
      "type": "string"
    },
    "published_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
