{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default (Debug)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_SHARED_LIBS": "ON",
                "BUILD_TESTS": "ON",
                "BUILD_GSVG": "ON",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "ci",
            "displayName": "CI Build",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "VCPKG_MANIFEST_DIR": "${sourceDir}/third_party"
            }
        },
        {
            "name": "ci-common",
            "displayName": "CI Common Build",
            "inherits": "ci",
            "cacheVariables": {
                "BUILD_TESTS": "ON",
                "BUILD_GSVG": "OFF",
                "XPE_WARNINGS_AS_ERRORS": "ON",
                "VCPKG_MANIFEST_DIR": "${sourceDir}/third_party/common"
            }
        }
    ],
    "buildPresets": [
        { "name": "default", "configurePreset": "default" },
        { "name": "release", "configurePreset": "release" },
        { "name": "ci", "configurePreset": "ci" },
        { "name": "ci-common", "configurePreset": "ci-common" }
    ],
    "testPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "output": { "outputOnFailure": true }
        }
    ]
}
